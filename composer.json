{
  "name": "webmedia/app",
  "description": "Small WEB media and CMS built on a lightweight PHP foundation.",
  "type": "project",
  "license": "proprietary",
  "repositories": [
    {
      "type": "path",
      "url": "packages/framework",
      "options": {
        "reference": "config",
        "symlink": true,
        "versions": {
          "pera/framework": "dev-main"
        }
      }
    }
  ],
  "require": {
    "php": ">=8.5",
    "ezyang/htmlpurifier": "^4.17",
    "intervention/image": "^3.9",
    "latte/latte": "^3.0",
    "league/commonmark": "^2.5",
    "pera/framework": "dev-main",
    "psr/log": "^3.0",
    "psr/simple-cache": "^3.0",
    "robmorgan/phinx": "^0.16",
    "symfony/mailer": "^7.0",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "App\\Kernel\\": "apps/kernel/src/",
      "App\\Shared\\": "apps/shared/src/",
      "App\\Front\\": "apps/front/src/",
      "App\\FrontBusiness\\": "apps/front-business/src/",
      "App\\Cms\\": "apps/cms/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Pera\\Framework\\Tests\\": "packages/framework/tests/",
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "analyse": "phpstan analyse --memory-limit=1G",
    "test": "phpunit",
    "migrate": "phinx migrate",
    "seed": "phinx seed:run"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true
    }
  }
}
