{
  "name": "webmedia/app",
  "description": "Small WEB media and CMS built on a lightweight PHP foundation.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.5",
    "ezyang/htmlpurifier": "^4.17",
    "intervention/image": "^3.9",
    "latte/latte": "^3.0",
    "league/commonmark": "^2.5",
    "nikic/fast-route": "^1.3",
    "nyholm/psr7": "^1.8",
    "robmorgan/phinx": "^0.16",
    "spiral/roadrunner-http": "^4.1",
    "symfony/mailer": "^7.0",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "App\\Framework\\": "src/Framework/",
      "App\\Front\\": "apps/front/src/",
      "App\\Cms\\": "apps/cms/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "analyse": "phpstan analyse --memory-limit=1G",
    "test": "phpunit",
    "migrate": "phinx migrate",
    "seed": "phinx seed:run"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true
    }
  }
}
