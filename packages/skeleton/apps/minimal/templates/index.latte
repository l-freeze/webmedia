<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{$title}</title>
    <style>
        body { margin: 0; font-family: system-ui, sans-serif; color: #1f2937; background: #f8fafc; }
        main { max-width: 720px; margin: 72px auto; padding: 0 20px; }
        .panel { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: 28px; box-shadow: 0 10px 24px rgba(15, 23, 42, .06); }
        h1 { margin: 0 0 12px; font-size: 32px; line-height: 1.25; }
        p { margin: 0 0 16px; line-height: 1.7; }
        code { display: inline-block; padding: 3px 7px; border-radius: 6px; background: #f1f5f9; color: #334155; }
    </style>
</head>
<body>
    <main>
        <section class="panel">
            <h1>{$title}</h1>
            <p>{$message}</p>
            <p>Route: <code>{$path}</code></p>
        </section>
    </main>
</body>
</html>
