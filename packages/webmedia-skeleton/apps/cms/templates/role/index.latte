{layout '../layout/default.latte'}
{block content}
<section class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
  <h1 class="mb-4 text-2xl font-bold">ロール</h1>
  <div class="grid gap-4 lg:grid-cols-2">
    {foreach $roles as $role}
      <div class="rounded-lg border border-slate-200 p-4">
        <h2 class="mb-3 text-base font-bold">{$role['code']}</h2>
        <div class="flex flex-wrap gap-2">
          {foreach $role['permissions'] as $permission}
            <span class="inline-flex rounded-full bg-slate-100 px-2.5 py-1 text-xs font-bold text-slate-700">{$permission}</span>
          {/foreach}
        </div>
      </div>
    {/foreach}
  </div>
</section>
{/block}
