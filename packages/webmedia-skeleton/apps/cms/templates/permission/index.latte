{layout '../layout/default.latte'}
{block content}
<section class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
  <h1 class="mb-4 text-2xl font-bold">パーミッション</h1>
  <div class="overflow-x-auto rounded-lg border border-slate-200">
    <table>
      <thead><tr><th>パーミッション</th><th>付与ロール</th></tr></thead>
      <tbody>
      {foreach $permissions as $permission}
        <tr>
          <td class="font-mono text-sm">{$permission['code']}</td>
          <td>
            <div class="flex flex-wrap gap-2">
              {foreach $permission['roles'] as $role}
                <span class="inline-flex rounded-full bg-slate-100 px-2.5 py-1 text-xs font-bold text-slate-700">{$role}</span>
              {/foreach}
            </div>
          </td>
        </tr>
      {/foreach}
      </tbody>
    </table>
  </div>
</section>
{/block}
