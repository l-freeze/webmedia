{layout '../layout/default.latte'}
{block content}
<div class="mb-4 flex flex-wrap items-center justify-between gap-4">
  <h1 class="text-2xl font-bold">問い合わせ管理</h1>
  <span class="text-sm font-bold text-slate-500">{$pagination['total_items']}件</span>
</div>
<div class="overflow-x-auto rounded-lg border border-slate-200 bg-white">
  <table>
    <thead><tr><th>件名</th><th>名前</th><th>メール</th><th>状態</th><th>受信日</th><th>操作</th></tr></thead>
    <tbody>
    {foreach $inquiries as $inquiry}
      <tr>
        <td><a class="font-bold text-blue-600 hover:text-blue-700" href="/admin/inquiries/{$inquiry->id}">{$inquiry->subject}</a></td>
        <td>{$inquiry->name}</td>
        <td><a class="text-blue-600 hover:text-blue-700" href="mailto:{$inquiry->email}">{$inquiry->email}</a></td>
        <td><span class="inline-flex rounded-full bg-slate-100 px-2.5 py-1 text-xs font-bold text-slate-700">{$inquiry->statusLabel}</span></td>
        <td>{$inquiry->createdAt}</td>
        <td>
          <div class="flex flex-wrap items-center gap-2">
            <a class="inline-flex min-h-9 items-center justify-center rounded-lg bg-blue-600 px-3 py-1.5 text-sm font-bold text-white hover:bg-blue-700" href="/admin/inquiries/{$inquiry->id}">詳細</a>
          </div>
        </td>
      </tr>
    {/foreach}
    {if count($inquiries) === 0}
      <tr><td colspan="6" class="text-slate-500">問い合わせはありません。</td></tr>
    {/if}
    </tbody>
  </table>
</div>
{if $pagination['total_pages'] > 1}
  <nav class="mt-4 flex flex-wrap items-center justify-end gap-2" aria-label="問い合わせページ">
    {if $pagination['previous_page'] !== null}
      <a class="inline-flex min-h-9 items-center justify-center rounded-lg bg-slate-200 px-3 py-1.5 text-sm font-bold text-slate-800 hover:bg-slate-300" href="/admin/inquiries?page={$pagination['previous_page']}">前へ</a>
    {/if}
    <span class="text-sm font-bold text-slate-500">{$pagination['current_page']} / {$pagination['total_pages']}</span>
    {if $pagination['next_page'] !== null}
      <a class="inline-flex min-h-9 items-center justify-center rounded-lg bg-slate-200 px-3 py-1.5 text-sm font-bold text-slate-800 hover:bg-slate-300" href="/admin/inquiries?page={$pagination['next_page']}">次へ</a>
    {/if}
  </nav>
{/if}
{/block}
