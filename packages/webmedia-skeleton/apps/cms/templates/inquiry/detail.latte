{layout '../layout/default.latte'}
{block content}
<div class="mb-4">
  <a class="inline-flex min-h-9 items-center justify-center rounded-lg bg-slate-200 px-3 py-1.5 text-sm font-bold text-slate-800 hover:bg-slate-300" href="/admin/inquiries">一覧へ戻る</a>
</div>
<section class="grid gap-5 rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
  {ifset $flash}
    <div class="rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 font-bold text-emerald-700" role="status" aria-live="polite" data-auto-dismiss>{$flash}</div>
  {/ifset}
  {ifset $error}
    <div class="rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 font-bold text-rose-700" role="alert" data-auto-dismiss>{$error}</div>
  {/ifset}
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <h1 class="text-2xl font-bold">{$inquiry->subject}</h1>
      <p class="mt-1 text-sm font-bold text-slate-500">受信日 {$inquiry->createdAt}</p>
    </div>
    <span class="inline-flex rounded-full bg-slate-100 px-2.5 py-1 text-xs font-bold text-slate-700">{$inquiry->statusLabel}</span>
  </div>
  <dl class="grid gap-4 md:grid-cols-2">
    <div>
      <dt class="text-sm font-bold text-slate-500">名前</dt>
      <dd class="mt-1 text-slate-900">{$inquiry->name}</dd>
    </div>
    <div>
      <dt class="text-sm font-bold text-slate-500">メール</dt>
      <dd class="mt-1"><a class="text-blue-600 hover:text-blue-700" href="mailto:{$inquiry->email}">{$inquiry->email}</a></dd>
    </div>
    <div>
      <dt class="text-sm font-bold text-slate-500">更新日</dt>
      <dd class="mt-1 text-slate-900">{$inquiry->updatedAt}</dd>
    </div>
  </dl>
  <div>
    <h2 class="mb-2 text-sm font-bold text-slate-500">内容</h2>
    <div class="whitespace-pre-wrap rounded-lg border border-slate-200 bg-slate-50 p-4 text-slate-900">{$inquiry->message}</div>
  </div>
  <form method="post" action="/admin/inquiries/{$inquiry->id}" class="grid gap-4 rounded-lg border border-slate-200 bg-slate-50 p-4">
    <input type="hidden" name="_csrf" value="{$csrf}">
    <label>状態
      <select name="status">
        {foreach $statusOptions as $value => $label}
          <option value="{$value}" {if (($formInput['status'] ?? $inquiry->status) === $value)}selected{/if}>{$label}</option>
        {/foreach}
      </select>
    </label>
    <label>管理メモ<textarea name="admin_note" maxlength="1000">{$formInput['admin_note'] ?? $inquiry->adminNote}</textarea></label>
    <div class="flex justify-end">
      <button class="inline-flex min-h-10 items-center justify-center rounded-lg bg-blue-600 px-4 py-2 font-bold text-white hover:bg-blue-700" type="submit">状態を保存</button>
    </div>
  </form>
</section>
{/block}
