{layout '../layout/default.latte'}
{block content}
<div class="overflow-x-auto rounded-lg border border-slate-200 bg-white">
  <table>
    <thead><tr><th>版</th><th>タイトル</th><th>状態</th><th>保存日時</th><th>操作</th></tr></thead>
    <tbody>
    {foreach $versions as $version}
      <tr>
        <td>{$version['version_no']}</td>
        <td>{$version['title']}</td>
        <td>{$version['status']}</td>
        <td>{$version['created_at']}</td>
        <td>
          <div class="flex flex-wrap items-center gap-2">
            <a class="inline-flex min-h-9 items-center justify-center rounded-lg bg-emerald-600 px-3 py-1.5 text-sm font-bold text-white hover:bg-emerald-700" href="/admin/articles/{$articleId}/history/{$version['version_no']}/preview">プレビュー</a>
            <form class="m-0" method="post" action="/admin/articles/{$articleId}/restore/{$version['version_no']}">
              <input type="hidden" name="_csrf" value="{$csrf}">
              <button class="inline-flex min-h-9 items-center justify-center rounded-lg bg-blue-600 px-3 py-1.5 text-sm font-bold text-white hover:bg-blue-700" data-confirm="この版へ復元しますか？">復元</button>
            </form>
          </div>
        </td>
      </tr>
    {/foreach}
    </tbody>
  </table>
</div>
{/block}
