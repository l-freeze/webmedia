<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>CMSログイン</title>
  <script src="/assets/js/tailwindcss-3.4.17.js"></script>
</head>
<body class="min-h-screen bg-slate-100 text-slate-800 antialiased">
<main class="grid min-h-screen place-items-center px-4">
  <section class="w-full max-w-md rounded-lg border border-slate-200 bg-white p-8 shadow-sm">
    <h1 class="mb-6 text-2xl font-bold">CMSログイン</h1>
    {if isset($error)}<p class="mb-4 rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 font-bold text-rose-700">{$error}</p>{/if}
    <form class="grid gap-4 [&_input]:mt-1 [&_input]:w-full [&_input]:rounded-lg [&_input]:border [&_input]:border-slate-300 [&_input]:bg-white [&_input]:px-3 [&_input]:py-2 [&_input]:text-slate-900 [&_input]:shadow-sm [&_label]:block [&_label]:text-sm [&_label]:font-bold [&_label]:text-slate-700" method="post" action="/admin/login">
      <input type="hidden" name="_csrf" value="{$csrf}">
      <label>メールアドレス<input type="email" name="email" required></label>
      <label>パスワード<input type="password" name="password" required></label>
      <button class="inline-flex min-h-10 items-center justify-center rounded-lg bg-blue-600 px-4 py-2 font-bold text-white hover:bg-blue-700" type="submit">ログイン</button>
    </form>
  </section>
</main>
</body>
</html>
