{layout 'layout/default.latte'}
{block content}
<div class="front-grid">
  <section>
    <div class="card front-hero{if ($heroImage ?? '') !== ''} front-hero--image{/if}"{if ($heroImage ?? '') !== ''} style="--hero-image: url('{$heroImage}')"{/if}>
      <div class="front-hero__copy">
        <h1>{$heroTitle ?? $siteName}</h1>
        <p class="muted">{$heroDescription ?? $description ?? ''}</p>
      </div>
      <div class="front-hero__visual" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </div>
    </div>
    <div class="article-list" style="margin-top:16px">
      {if count($articles) === 0}
        <p class="card muted">公開中の記事はありません。</p>
      {else}
        {foreach $articles as $article}
          {include 'partials/article-card.latte', article: $article}
        {/foreach}
      {/if}
    </div>
    {if $pagination['total_pages'] > 1}
      <nav class="pagination" aria-label="記事ページ">
        {if $pagination['previous_page'] !== null}
          <a class="button secondary" href="/?page={$pagination['previous_page']}">前へ</a>
        {else}
          <span class="button secondary is-disabled" aria-disabled="true">前へ</span>
        {/if}
        <span class="pagination__status">{$pagination['current_page']} / {$pagination['total_pages']}</span>
        {if $pagination['next_page'] !== null}
          <a class="button secondary" href="/?page={$pagination['next_page']}">次へ</a>
        {else}
          <span class="button secondary is-disabled" aria-disabled="true">次へ</span>
        {/if}
      </nav>
    {/if}
  </section>
  {* 表示/非表示はテーマ依存だが構造は共通。出し分けは CSS (.front-grid > aside) 側で行う。 *}
  <aside class="card category-panel">
    <h2>カテゴリ</h2>
    {foreach $categories as $category}
      <p><a href="/categories/{$category['slug']}">{$category['name']}</a><br><span class="muted">{$category['article_count']}件</span></p>
    {/foreach}
  </aside>
</div>
{/block}
