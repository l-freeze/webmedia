{
    "name": "pera/webmedia-skeleton",
    "description": "A production-oriented WEB media and CMS project skeleton for Pera.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "ezyang/htmlpurifier": "^4.17",
        "intervention/image": "^3.9",
        "latte/latte": "^3.0",
        "league/commonmark": "^2.5",
        "pera/framework": "^0.1",
        "php": ">=8.5",
        "psr/log": "^3.0",
        "psr/simple-cache": "^3.0",
        "robmorgan/phinx": "^0.16",
        "symfony/mailer": "^7.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\Cms\\": "apps/cms/src/",
            "App\\Front\\": "apps/front/src/",
            "App\\Kernel\\": "apps/kernel/src/",
            "App\\Shared\\": "apps/shared/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=1G",
        "test": "phpunit",
        "migrate": "phinx migrate",
        "seed": "phinx seed:run"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
