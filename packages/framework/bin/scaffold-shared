#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Scaffold shared application support under apps/shared.
 *
 * Usage:
 *   php vendor/bin/scaffold-shared
 *   php vendor/bin/scaffold-shared --root=/tmp/example
 */

$args = array_values(array_slice($argv, 1));
/** @var Closure(?string, string, ?string): string $resolveProjectRoot */
$resolveProjectRoot = require __DIR__ . '/scaffold-project-root.php';
$root = $resolveProjectRoot(
    $GLOBALS['_composer_autoload_path'] ?? null,
    dirname(__DIR__),
    getcwd() !== false ? getcwd() : null,
);
foreach ($args as $arg) {
    if (str_starts_with($arg, '--root=')) {
        $root = rtrim(substr($arg, strlen('--root=')), '/');
        continue;
    }

    fwrite(STDERR, "Usage: php vendor/bin/scaffold-shared [--root=/path/to/project]\n");
    exit(1);
}

$sharedRoot = "{$root}/apps/shared";
/** @var Closure(string, array<string, string>): array<string, string> $loadTemplateFiles */
$loadTemplateFiles = require __DIR__ . '/scaffold-template-files.php';
try {
    $templateFiles = $loadTemplateFiles(dirname(__DIR__) . '/templates/shared');
} catch (Throwable $throwable) {
    fwrite(STDERR, $throwable->getMessage() . "\n");
    exit(1);
}

$files = [];
$directories = [];
foreach ($templateFiles as $relativePath => $contents) {
    $path = $sharedRoot . '/' . $relativePath;
    $files[$path] = $contents;
    $directory = dirname($path);
    if ($directory !== $sharedRoot) {
        $directories[$directory] = true;
    }
}
ksort($files);
ksort($directories);
$createdDirectories = array_keys($directories);
$createdFiles = array_keys($files);

/** @var Closure(string, string): ScaffoldFilesystemTransaction $createScaffoldTransaction */
$createScaffoldTransaction = require __DIR__ . '/scaffold-transaction.php';
try {
    $scaffoldTransaction = $createScaffoldTransaction($root, $sharedRoot);
} catch (Throwable $throwable) {
    fwrite(STDERR, $throwable->getMessage() . "\n");
    exit(1);
}
$directories = $scaffoldTransaction->stagePaths(paths: $createdDirectories);
$files = $scaffoldTransaction->stageFiles(files: $files);

/**
 * @var Closure(string, list<string>, array<string, string>): array{
 *     required: array<string, string>,
 *     added: array<string, string>,
 *     present: array<string, string>,
 *     autoloadRequired: array<string, string>,
 *     autoloadAdded: array<string, string>,
 *     autoloadPresent: array<string, string>,
 *     missingManifest: bool,
 *     messages: list<string>
 * } $syncComposerRequirements
 */
$syncComposerRequirements = require __DIR__ . '/scaffold-composer-requirements.php';
try {
    $composerRequirementResult = $syncComposerRequirements(
        $root,
        ['latte'],
        ['App\\Shared\\' => 'apps/shared/src/'],
    );
} catch (Throwable $throwable) {
    fwrite(STDERR, "Failed to prepare scaffold Composer requirements: {$throwable->getMessage()}\n");
    exit(1);
}

foreach ($directories as $directory) {
    ensureDirectory($directory);
}
foreach ($files as $path => $contents) {
    writeFile(path: $path, contents: $contents);
}
$scaffoldTransaction->commit();

echo "Created shared scaffold: apps/shared\n\n";
echo "Created directories:\n";
foreach ($createdDirectories as $directory) {
    echo '- ' . relativePath(root: $root, path: $directory) . "\n";
}
echo "\n";
echo "Created files:\n";
foreach ($createdFiles as $path) {
    echo '- ' . relativePath(root: $root, path: $path) . "\n";
}
if ($composerRequirementResult['messages'] !== []) {
    echo "\n";
    foreach ($composerRequirementResult['messages'] as $message) {
        echo $message . "\n";
    }
}

function ensureDirectory(string $directory): void
{
    if (is_dir($directory)) {
        return;
    }

    if (!mkdir($directory, 0775, true) && !is_dir($directory)) {
        throw new RuntimeException("Failed to create directory: {$directory}");
    }
}

function writeFile(string $path, string $contents): void
{
    if (file_put_contents($path, $contents) === false) {
        throw new RuntimeException("Failed to write file: {$path}");
    }
}

function relativePath(string $root, string $path): string
{
    $root = rtrim($root, '/') . '/';
    return str_starts_with($path, $root) ? substr($path, strlen($root)) : $path;
}
