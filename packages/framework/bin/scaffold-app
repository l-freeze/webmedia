#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Scaffold an app under apps/{name}.
 *
 * Usage:
 *   php vendor/bin/scaffold-app api /api
 *   php vendor/bin/scaffold-app api /api --template=bare
 *   php vendor/bin/scaffold-app todo /todo --template=todo
 *   php vendor/bin/scaffold-app api /api --template=layered
 *   php vendor/bin/scaffold-app preview /preview --root=/tmp/example
 */

$args = array_values(array_slice($argv, 1));
/** @var Closure(?string, string, ?string): string $resolveProjectRoot */
$resolveProjectRoot = require __DIR__ . '/scaffold-project-root.php';
$root = $resolveProjectRoot(
    $GLOBALS['_composer_autoload_path'] ?? null,
    dirname(__DIR__),
    getcwd() !== false ? getcwd() : null,
);
$template = 'minimal';
$filteredArgs = [];
foreach ($args as $arg) {
    if (str_starts_with($arg, '--root=')) {
        $root = rtrim(substr($arg, strlen('--root=')), '/');
        continue;
    }
    if (str_starts_with($arg, '--template=')) {
        $template = substr($arg, strlen('--template='));
        continue;
    }
    $filteredArgs[] = $arg;
}

if (count($filteredArgs) !== 2) {
    fwrite(STDERR, "Usage: php vendor/bin/scaffold-app <name> <path-prefix> [--template=bare|minimal|todo|layered] [--root=/path/to/project]\n");
    exit(1);
}

[$name, $pathPrefix] = $filteredArgs;

if (!preg_match('/^[a-z][a-z0-9-]*$/', $name)) {
    fwrite(STDERR, "App name must match /^[a-z][a-z0-9-]*$/.\n");
    exit(1);
}

if ($pathPrefix === '' || $pathPrefix[0] !== '/') {
    fwrite(STDERR, "Path prefix must start with \"/\".\n");
    exit(1);
}

if (!in_array($template, ['bare', 'minimal', 'todo', 'layered'], true)) {
    fwrite(STDERR, "Template must be one of: bare, minimal, todo, layered.\n");
    exit(1);
}

$composerFeatures = in_array($template, ['minimal', 'todo'], true) ? ['latte'] : [];

$appRoot = "{$root}/apps/{$name}";
$namespace = namespaceName(name: $name);
$healthPath = rtrim($pathPrefix, '/') . '/health';
if ($healthPath === '/health' && $pathPrefix !== '/') {
    $healthPath = $pathPrefix . '/health';
}
$contactPath = rtrim($pathPrefix, '/') . '/contact';
$basePath = rtrim($pathPrefix, '/');
if ($basePath === '') {
    $basePath = '/';
}
$viewBasePath = $basePath === '/' ? '' : $basePath;
$todoCompletePath = $viewBasePath . '/{id:[a-f0-9]+}/complete';

$directories = [
    "{$appRoot}/config",
    "{$appRoot}/src",
];
$paths = [
    "{$appRoot}/config/routes.php",
    "{$appRoot}/config/container.php",
    "{$appRoot}/config/middleware.php",
    "{$appRoot}/src/.gitkeep",
];

if ($template === 'layered') {
    $directories = array_merge($directories, [
        "{$appRoot}/src/Application/Health/Show",
        "{$appRoot}/src/Application/Contact/Submit",
        "{$appRoot}/src/Domain/Entity",
        "{$appRoot}/src/Domain/Repository",
        "{$appRoot}/src/Domain/Value",
        "{$appRoot}/src/Presentation/Http/Controller/Contact/Submit",
        "{$appRoot}/src/Presentation/Http/Controller/Health/Show",
        "{$appRoot}/src/Infrastructure/Http/Middleware",
        "{$appRoot}/src/Infrastructure/Persistence",
    ]);
    $paths = array_merge($paths, [
        "{$appRoot}/src/Application/Health/Show/Input.php",
        "{$appRoot}/src/Application/Health/Show/Output.php",
        "{$appRoot}/src/Application/Health/Show/Interactor.php",
        "{$appRoot}/src/Application/Contact/Submit/Input.php",
        "{$appRoot}/src/Application/Contact/Submit/Output.php",
        "{$appRoot}/src/Application/Contact/Submit/Interactor.php",
        "{$appRoot}/src/Domain/Entity/HealthCheck.php",
        "{$appRoot}/src/Domain/Repository/IHealthCheckRepository.php",
        "{$appRoot}/src/Domain/Value/HealthMessage.php",
        "{$appRoot}/src/Presentation/Http/Controller/Contact/Submit/Controller.php",
        "{$appRoot}/src/Presentation/Http/Controller/Health/Show/Controller.php",
        "{$appRoot}/src/Infrastructure/Http/Middleware/AppNameHeaderMiddleware.php",
        "{$appRoot}/src/Infrastructure/Persistence/PdoHealthCheckRepository.php",
    ]);
}

if ($template === 'todo') {
    $directories = array_merge($directories, [
        "{$appRoot}/src/Application/Todo",
        "{$appRoot}/src/Presentation/Http/Controller/Todo/Complete",
        "{$appRoot}/src/Presentation/Http/Controller/Todo/Index",
        "{$appRoot}/src/Presentation/Http/Controller/Todo/Store",
        "{$appRoot}/src/Infrastructure/Persistence",
        "{$appRoot}/templates",
    ]);
    $paths = array_merge($paths, [
        "{$appRoot}/src/Application/Todo/TodoItem.php",
        "{$appRoot}/src/Application/Todo/ITodoRepository.php",
        "{$appRoot}/src/Presentation/Http/Controller/Todo/Complete/Controller.php",
        "{$appRoot}/src/Presentation/Http/Controller/Todo/Index/Controller.php",
        "{$appRoot}/src/Presentation/Http/Controller/Todo/Store/Controller.php",
        "{$appRoot}/src/Infrastructure/Persistence/PdoTodoRepository.php",
        "{$appRoot}/templates/index.latte",
    ]);
}

if ($template === 'minimal') {
    $directories = array_merge($directories, [
        "{$appRoot}/src/Presentation/Http/Controller/Index",
        "{$appRoot}/templates",
    ]);
    $paths = array_merge($paths, [
        "{$appRoot}/src/Presentation/Http/Controller/Index/Controller.php",
        "{$appRoot}/templates/index.latte",
    ]);
}

foreach ($paths as $path) {
    if (file_exists($path)) {
        fwrite(STDERR, "Refusing to overwrite existing file: {$path}\n");
        exit(1);
    }
}

/**
 * @var Closure(string, list<string>): array{
 *     required: array<string, string>,
 *     added: array<string, string>,
 *     present: array<string, string>,
 *     missingManifest: bool,
 *     messages: list<string>
 * } $syncComposerRequirements
 */
$syncComposerRequirements = require __DIR__ . '/scaffold-composer-requirements.php';
try {
    $composerRequirementResult = $syncComposerRequirements($root, $composerFeatures);
} catch (Throwable $throwable) {
    fwrite(STDERR, "Failed to prepare scaffold Composer requirements: {$throwable->getMessage()}\n");
    exit(1);
}

foreach ($directories as $directory) {
    ensureDirectory($directory);
}

if ($template === 'layered') {
    writeFile("{$appRoot}/config/routes.php", renderTemplate(<<<'PHP'
<?php

declare(strict_types=1);

use App\{{ namespace }}\Presentation\Http\Controller\Health\Show\Controller as HealthShowController;
use App\{{ namespace }}\Presentation\Http\Controller\Contact\Submit\Controller as ContactSubmitController;

return [
    ['GET', '{{ healthPath }}', HealthShowController::class],
    ['POST', '{{ contactPath }}', ContactSubmitController::class],
];
PHP, namespace: $namespace, healthPath: $healthPath, name: $name, contactPath: $contactPath));
} elseif ($template === 'todo') {
    writeFile("{$appRoot}/config/routes.php", renderTemplate(<<<'PHP'
<?php

declare(strict_types=1);

use App\{{ namespace }}\Presentation\Http\Controller\Todo\Complete\Controller as TodoCompleteController;
use App\{{ namespace }}\Presentation\Http\Controller\Todo\Index\Controller as TodoIndexController;
use App\{{ namespace }}\Presentation\Http\Controller\Todo\Store\Controller as TodoStoreController;

return [
    ['GET', '{{ basePath }}', TodoIndexController::class],
    ['POST', '{{ basePath }}', TodoStoreController::class],
    ['POST', '{{ todoCompletePath }}', TodoCompleteController::class],
];
PHP, namespace: $namespace, healthPath: $healthPath, name: $name, contactPath: $contactPath, basePath: $basePath, todoCompletePath: $todoCompletePath));
} elseif ($template === 'minimal') {
    writeFile("{$appRoot}/config/routes.php", renderTemplate(<<<'PHP'
<?php

declare(strict_types=1);

use App\{{ namespace }}\Presentation\Http\Controller\Index\Controller as IndexController;

return [
    ['GET', '{{ basePath }}', IndexController::class],
];
PHP, namespace: $namespace, healthPath: $healthPath, name: $name, basePath: $basePath));
} else {
    writeFile("{$appRoot}/config/routes.php", <<<'PHP'
<?php

declare(strict_types=1);

return [
];
PHP);
}

if ($template === 'layered') {
    writeFile("{$appRoot}/config/container.php", renderTemplate(<<<'PHP'
<?php

declare(strict_types=1);

use App\{{ namespace }}\Domain\Repository\IHealthCheckRepository;
use App\{{ namespace }}\Infrastructure\Http\Middleware\AppNameHeaderMiddleware;
use App\{{ namespace }}\Infrastructure\Persistence\PdoHealthCheckRepository;
use Pera\Framework\Container\Container;

$root = dirname(__DIR__, 3);
$container = new Container();

$sharedContainer = require $root . '/apps/shared/config/container.php';
if (!is_callable($sharedContainer)) {
    throw new \RuntimeException('Shared container configuration is invalid.');
}
$sharedContainer($container, $root);

$container->bind(abstract: IHealthCheckRepository::class, concrete: PdoHealthCheckRepository::class);
$container->singleton(id: AppNameHeaderMiddleware::class, factory: static fn (): AppNameHeaderMiddleware => new AppNameHeaderMiddleware(appName: '{{ name }}'));

return $container;
PHP, namespace: $namespace, healthPath: $healthPath, name: $name));
} elseif ($template === 'todo') {
    writeFile("{$appRoot}/config/container.php", renderTemplate(<<<'PHP'
<?php

declare(strict_types=1);

use App\{{ namespace }}\Application\Todo\ITodoRepository;
use App\{{ namespace }}\Infrastructure\Persistence\PdoTodoRepository;
use Pera\Framework\Container\Container;
use Pera\Framework\View\ITemplateRenderer;
use App\Shared\View\Infrastructure\LatteTemplateRenderer;

$root = dirname(__DIR__, 3);
$container = new Container();

$kernelContainer = require $root . '/apps/kernel/config/container.php';
if (!is_callable($kernelContainer)) {
    throw new \RuntimeException('Kernel container configuration is invalid.');
}
$kernelContainer($container);

$sharedContainer = require $root . '/apps/shared/config/container.php';
if (!is_callable($sharedContainer)) {
    throw new \RuntimeException('Shared container configuration is invalid.');
}
$sharedContainer($container, $root);

$container->bind(abstract: ITodoRepository::class, concrete: PdoTodoRepository::class);
$container->singleton(id: ITemplateRenderer::class, factory: fn (): ITemplateRenderer => new LatteTemplateRenderer(
    templateDirectory: $root . '/apps/{{ name }}/templates',
));

return $container;
PHP, namespace: $namespace, healthPath: $healthPath, name: $name));
} elseif ($template === 'minimal') {
    writeFile("{$appRoot}/config/container.php", renderTemplate(<<<'PHP'
<?php

declare(strict_types=1);

use Pera\Framework\Container\Container;
use Pera\Framework\View\ITemplateRenderer;
use App\Shared\View\Infrastructure\LatteTemplateRenderer;

$root = dirname(__DIR__, 3);
$container = new Container();

$kernelContainer = require $root . '/apps/kernel/config/container.php';
if (!is_callable($kernelContainer)) {
    throw new \RuntimeException('Kernel container configuration is invalid.');
}
$kernelContainer($container);

$sharedContainer = require $root . '/apps/shared/config/container.php';
if (!is_callable($sharedContainer)) {
    throw new \RuntimeException('Shared container configuration is invalid.');
}
$sharedContainer($container, $root);

$container->singleton(id: ITemplateRenderer::class, factory: fn (): ITemplateRenderer => new LatteTemplateRenderer(
    templateDirectory: $root . '/apps/{{ name }}/templates',
));

return $container;
PHP, namespace: $namespace, healthPath: $healthPath, name: $name));
} else {
    writeFile("{$appRoot}/config/container.php", <<<'PHP'
<?php

declare(strict_types=1);

use Pera\Framework\Container\Container;

$root = dirname(__DIR__, 3);
$container = new Container();

$sharedContainer = require $root . '/apps/shared/config/container.php';
if (!is_callable($sharedContainer)) {
    throw new \RuntimeException('Shared container configuration is invalid.');
}
$sharedContainer($container, $root);

return $container;
PHP);
}

if ($template === 'layered') {
    writeFile("{$appRoot}/config/middleware.php", renderTemplate(<<<'PHP'
<?php

declare(strict_types=1);

use App\{{ namespace }}\Infrastructure\Http\Middleware\AppNameHeaderMiddleware;

$root = dirname(__DIR__, 3);
$sharedMiddleware = require $root . '/apps/shared/config/middleware.php';
if (!is_array($sharedMiddleware)) {
    throw new \RuntimeException('Shared middleware configuration is invalid.');
}

return [
    ...$sharedMiddleware,

    // Shared middleware includes security headers and CSRF protection.
    // CSRF is disabled when APP_ENV is stg, staging, dev, develop, development, or test.
    // Exclude paths with CSRF_EXCLUDED_PATHS=/webhook/*,/api/external.
    // Add app-specific middleware here.
    // Example: AppNameHeaderMiddleware::class,
    AppNameHeaderMiddleware::class,
];
PHP, namespace: $namespace, healthPath: $healthPath, name: $name));
} else {
    writeFile("{$appRoot}/config/middleware.php", <<<'PHP'
<?php

declare(strict_types=1);

$root = dirname(__DIR__, 3);
$sharedMiddleware = require $root . '/apps/shared/config/middleware.php';
if (!is_array($sharedMiddleware)) {
    throw new \RuntimeException('Shared middleware configuration is invalid.');
}

return [
    ...$sharedMiddleware,

    // Shared middleware includes security headers and CSRF protection.
    // CSRF is disabled when APP_ENV is stg, staging, dev, develop, development, or test.
    // Exclude paths with CSRF_EXCLUDED_PATHS=/webhook/*,/api/external.
    // Add app-specific middleware here.
    // Example: App\YourApp\Infrastructure\Http\Middleware\YourMiddleware::class,
];
PHP);
}

writeFile("{$appRoot}/src/.gitkeep", '');

if ($template === 'layered') {
    writeLayeredSource(appRoot: $appRoot, namespace: $namespace, name: $name);
}
if ($template === 'minimal') {
    writeMinimalSource(appRoot: $appRoot, namespace: $namespace, name: $name, basePath: $basePath);
}
if ($template === 'todo') {
    writeTodoSource(appRoot: $appRoot, namespace: $namespace, name: $name, basePath: $basePath, viewBasePath: $viewBasePath);
}

$definition = <<<PHP
new ApplicationDefinition(
    name: '{$name}',
    pathPrefix: '{$pathPrefix}',
    routesPath: '/apps/{$name}/config/routes.php',
    containerPath: '/apps/{$name}/config/container.php',
    middlewarePath: '/apps/{$name}/config/middleware.php',
),
PHP;

$autoload = "\"App\\\\{$namespace}\\\\\": \"apps/{$name}/src/\"";

echo "Created app scaffold: apps/{$name} ({$template})\n\n";
echo "Created directories:\n";
foreach ($directories as $directory) {
    echo '- ' . relativePath(root: $root, path: $directory) . "\n";
}
echo "\n";
echo "Created files:\n";
foreach ($paths as $path) {
    echo '- ' . relativePath(root: $root, path: $path) . "\n";
}
echo "\n";
echo "Generated files:\n";
echo "- apps/{$name}/config/routes.php: Route definitions for this app.\n";
echo "- apps/{$name}/config/container.php: App DI container, after shared bindings.\n";
echo "- apps/{$name}/config/middleware.php: App middleware list, after shared middleware.\n";
echo "- apps/{$name}/src/.gitkeep: Placeholder for app source files.\n\n";
if ($template === 'bare') {
    echo "Bare starter:\n";
    echo "- Config only: routes, container, middleware, and src placeholder.\n";
    echo "- No route, Controller, ITemplateRenderer binding, or view template is generated.\n\n";
}
if ($template === 'minimal') {
    echo "Minimal starter:\n";
    echo "- Single-controller HTML starter at {$basePath}.\n";
    echo "- Presentation/Http/Controller/Index: Controller with PDO access and ITemplateRenderer output.\n";
    echo "- templates/index.latte: Single-page Latte view.\n\n";
}
if ($template === 'layered') {
    echo "Layered starter:\n";
    echo "- Application/Health/Show: Input, Output, and Interactor example.\n";
    echo "- Application/Contact/Submit: Input validation example using App\\Shared\\Validation.\n";
    echo "- Domain/Entity: HealthCheck entity example.\n";
    echo "- Domain/Value: HealthMessage value object example.\n";
    echo "- Domain/Repository: HealthCheck repository interface.\n";
    echo "- Presentation/Http/Controller: HTTP controller examples.\n";
    echo "- Infrastructure/Http/Middleware: App-specific middleware example.\n";
    echo "- Infrastructure/Persistence: PDO repository example.\n\n";
}
if ($template === 'todo') {
    echo "Todo starter:\n";
    echo "- Application/Todo: Todo DTO and repository interface.\n";
    echo "- Presentation/Http/Controller/Todo: List, create, and complete actions.\n";
    echo "- Infrastructure/Persistence: PDO repository with a small self-contained todos table.\n";
    echo "- templates/index.latte: Latte view for the todo list.\n\n";
}
echo "Add this ApplicationDefinition to apps/kernel/config/application.php:\n\n";
echo $definition . "\n\n";
echo "Add this PSR-4 entry to composer.json when you add PHP classes under apps/{$name}/src:\n\n";
echo $autoload . "\n\n";
echo "Then run:\n\n";
echo "composer dump-autoload\n";
if ($composerRequirementResult['messages'] !== []) {
    echo "\n";
    foreach ($composerRequirementResult['messages'] as $message) {
        echo $message . "\n";
    }
}

/** @phpstan-return non-empty-string */
function namespaceName(string $name): string
{
    $parts = explode('-', $name);
    $namespace = '';
    foreach ($parts as $part) {
        $namespace .= ucfirst($part);
    }

    return $namespace;
}

function ensureDirectory(string $path): void
{
    if (is_dir($path)) {
        return;
    }

    if (!mkdir($path, 0777, true) && !is_dir($path)) {
        throw new RuntimeException("Failed to create directory: {$path}");
    }
}

function writeFile(string $path, string $contents): void
{
    if (file_put_contents($path, $contents) === false) {
        throw new RuntimeException("Failed to write file: {$path}");
    }
}

function renderTemplate(string $contents, string $namespace, string $healthPath, string $name, string $contactPath = '', string $basePath = '', string $viewBasePath = '', string $todoCompletePath = ''): string
{
    return str_replace(
        ['{{ namespace }}', '{{ healthPath }}', '{{ name }}', '{{ contactPath }}', '{{ basePath }}', '{{ viewBasePath }}', '{{ todoCompletePath }}'],
        [$namespace, $healthPath, $name, $contactPath, $basePath, $viewBasePath, $todoCompletePath],
        $contents,
    );
}

function writeLayeredSource(string $appRoot, string $namespace, string $name): void
{
    writeFile("{$appRoot}/src/Application/Health/Show/Input.php", renderTemplate(<<<'PHP'
<?php

declare(strict_types=1);

namespace App\{{ namespace }}\Application\Health\Show;

final readonly class Input
{
}
PHP, namespace: $namespace, healthPath: '', name: $name));

    writeFile("{$appRoot}/src/Application/Health/Show/Output.php", renderTemplate(<<<'PHP'
<?php

declare(strict_types=1);

namespace App\{{ namespace }}\Application\Health\Show;

use App\{{ namespace }}\Domain\Entity\HealthCheck;

final readonly class Output
{
    public function __construct(public HealthCheck $healthCheck)
    {
    }

    /** @return array{status:string,message:string,database:string} */
    public function toArray(): array
    {
        return [
            'status' => $this->healthCheck->status,
            'message' => $this->healthCheck->message->value,
            'database' => $this->healthCheck->databaseOk ? 'ok' : 'ng',
        ];
    }
}
PHP, namespace: $namespace, healthPath: '', name: $name));

    writeFile("{$appRoot}/src/Application/Health/Show/Interactor.php", renderTemplate(<<<'PHP'
<?php

declare(strict_types=1);

namespace App\{{ namespace }}\Application\Health\Show;

use App\{{ namespace }}\Domain\Repository\IHealthCheckRepository;

final readonly class Interactor
{
    public function __construct(private IHealthCheckRepository $healthChecks)
    {
    }

    public function execute(Input $input): Output
    {
        return new Output(healthCheck: $this->healthChecks->get());
    }
}
PHP, namespace: $namespace, healthPath: '', name: $name));

    writeFile("{$appRoot}/src/Application/Contact/Submit/Input.php", renderTemplate(<<<'PHP'
<?php

declare(strict_types=1);

namespace App\{{ namespace }}\Application\Contact\Submit;

final readonly class Input
{
    public function __construct(
        public string $name,
        public string $email,
        public string $message,
    ) {
    }
}
PHP, namespace: $namespace, healthPath: '', name: $name));

    writeFile("{$appRoot}/src/Application/Contact/Submit/Output.php", renderTemplate(<<<'PHP'
<?php

declare(strict_types=1);

namespace App\{{ namespace }}\Application\Contact\Submit;

use App\Shared\Validation\ValidationOutput;

final readonly class Output
{
    public function __construct(public bool $accepted, public ValidationOutput $validation)
    {
    }

    public static function accepted(): self
    {
        return new self(accepted: true, validation: ValidationOutput::valid());
    }

    public static function invalid(ValidationOutput $validation): self
    {
        return new self(accepted: false, validation: $validation);
    }

    /** @return array{accepted:bool,error:?string} */
    public function toArray(): array
    {
        return [
            'accepted' => $this->accepted,
            'error' => $this->validation->firstMessage(),
        ];
    }
}
PHP, namespace: $namespace, healthPath: '', name: $name));

    writeFile("{$appRoot}/src/Application/Contact/Submit/Interactor.php", renderTemplate(<<<'PHP'
<?php

declare(strict_types=1);

namespace App\{{ namespace }}\Application\Contact\Submit;

use App\Shared\Validation\FormValidator;
use App\Shared\Validation\ValidationInput;

final readonly class Interactor
{
    public function execute(Input $input): Output
    {
        $validation = (new FormValidator(input: new ValidationInput(values: [
            'name' => $input->name,
            'email' => $input->email,
            'message' => $input->message,
        ])))
            ->required(field: 'name', label: '名前')
            ->required(field: 'email', label: 'メールアドレス')
            ->email(field: 'email', label: 'メールアドレス')
            ->required(field: 'message', label: '内容')
            ->output();

        if (!$validation->isValid()) {
            return Output::invalid(validation: $validation);
        }

        return Output::accepted();
    }
}
PHP, namespace: $namespace, healthPath: '', name: $name));

    writeFile("{$appRoot}/src/Domain/Entity/HealthCheck.php", renderTemplate(<<<'PHP'
<?php

declare(strict_types=1);

namespace App\{{ namespace }}\Domain\Entity;

use App\{{ namespace }}\Domain\Value\HealthMessage;

final readonly class HealthCheck
{
    public function __construct(
        public string $status,
        public HealthMessage $message,
        public bool $databaseOk,
    ) {
    }
}
PHP, namespace: $namespace, healthPath: '', name: $name));

    writeFile("{$appRoot}/src/Domain/Repository/IHealthCheckRepository.php", renderTemplate(<<<'PHP'
<?php

declare(strict_types=1);

namespace App\{{ namespace }}\Domain\Repository;

use App\{{ namespace }}\Domain\Entity\HealthCheck;

interface IHealthCheckRepository
{
    public function get(): HealthCheck;
}
PHP, namespace: $namespace, healthPath: '', name: $name));

    writeFile("{$appRoot}/src/Domain/Value/HealthMessage.php", renderTemplate(<<<'PHP'
<?php

declare(strict_types=1);

namespace App\{{ namespace }}\Domain\Value;

use InvalidArgumentException;

final readonly class HealthMessage
{
    public function __construct(public string $value)
    {
        if ($value === '') {
            throw new InvalidArgumentException('Health message must not be empty.');
        }
    }
}
PHP, namespace: $namespace, healthPath: '', name: $name));

    writeFile("{$appRoot}/src/Presentation/Http/Controller/Contact/Submit/Controller.php", renderTemplate(<<<'PHP'
<?php

declare(strict_types=1);

namespace App\{{ namespace }}\Presentation\Http\Controller\Contact\Submit;

use App\{{ namespace }}\Application\Contact\Submit\Input;
use App\{{ namespace }}\Application\Contact\Submit\Interactor;
use Pera\Framework\Http\Request;
use Pera\Framework\Http\Response;

final readonly class Controller
{
    public function __construct(private Interactor $interactor)
    {
    }

    /** @param array<string, string> $vars */
    public function __invoke(Request $request, array $vars = []): Response
    {
        $output = $this->interactor->execute(input: new Input(
            name: $request->input(key: 'name'),
            email: $request->input(key: 'email'),
            message: $request->input(key: 'message'),
        ));

        return new Response(
            body: json_encode($output->toArray(), JSON_THROW_ON_ERROR),
            status: $output->accepted ? 201 : 422,
            headers: ['Content-Type' => 'application/json; charset=utf-8'],
        );
    }
}
PHP, namespace: $namespace, healthPath: '', name: $name));

    writeFile("{$appRoot}/src/Presentation/Http/Controller/Health/Show/Controller.php", renderTemplate(<<<'PHP'
<?php

declare(strict_types=1);

namespace App\{{ namespace }}\Presentation\Http\Controller\Health\Show;

use App\{{ namespace }}\Application\Health\Show\Input;
use App\{{ namespace }}\Application\Health\Show\Interactor;
use Pera\Framework\Http\Request;
use Pera\Framework\Http\Response;

final readonly class Controller
{
    public function __construct(private Interactor $interactor)
    {
    }

    /** @param array<string, string> $vars */
    public function __invoke(Request $request, array $vars = []): Response
    {
        $output = $this->interactor->execute(input: new Input());

        return new Response(
            body: json_encode($output->toArray(), JSON_THROW_ON_ERROR),
            headers: ['Content-Type' => 'application/json; charset=utf-8'],
        );
    }
}
