    writeFile("{$appRoot}/src/Infrastructure/Persistence/PdoTodoRepository.php", renderTemplate(<<<'PHP'
<?php

declare(strict_types=1);

namespace App\{{ namespace }}\Infrastructure\Persistence;

use App\{{ namespace }}\Application\Todo\TodoItem;
use App\{{ namespace }}\Application\Todo\ITodoRepository;
use App\Shared\Database\PdoHelper;
use App\Shared\Database\PdoRow;
use PDO;

final readonly class PdoTodoRepository implements ITodoRepository
{
    public function __construct(private PDO $pdo)
    {
    }

    /** @return list<TodoItem> */
    public function all(): array
    {
        $this->ensureSchema();

        $items = [];
        foreach (PdoHelper::fetchAll(statement: PdoHelper::query(pdo: $this->pdo, sql: 'SELECT id, title, completed, created_at FROM todos ORDER BY completed ASC, created_at DESC')) as $row) {
            $items[] = $this->item(row: $row);
        }

        return $items;
    }

    public function add(string $title): void
    {
        $this->ensureSchema();

        $statement = PdoHelper::prepare(pdo: $this->pdo, sql: 'INSERT INTO todos (id, title, completed, created_at) VALUES (:id, :title, 0, :created_at)');
        PdoHelper::execute(statement: $statement, params: [
            'id' => bin2hex(random_bytes(16)),
            'title' => $title,
            'created_at' => date('Y-m-d H:i:s'),
        ]);
    }

    public function complete(string $id): void
    {
        $this->ensureSchema();

        $statement = PdoHelper::prepare(pdo: $this->pdo, sql: 'UPDATE todos SET completed = 1 WHERE id = :id');
        PdoHelper::execute(statement: $statement, params: ['id' => $id]);
    }

    private function ensureSchema(): void
    {
        $this->pdo->exec('CREATE TABLE IF NOT EXISTS todos (id VARCHAR(32) PRIMARY KEY, title VARCHAR(255) NOT NULL, completed SMALLINT NOT NULL DEFAULT 0, created_at VARCHAR(32) NOT NULL)');
    }

    /** @param array<string, mixed> $row */
    private function item(array $row): TodoItem
    {
        $todo = PdoRow::from(values: $row);

        return new TodoItem(
            id: $todo->string(key: 'id'),
            title: $todo->string(key: 'title'),
            completed: $todo->int(key: 'completed') === 1,
            createdAt: $todo->string(key: 'created_at'),
        );
    }
}
PHP, namespace: $namespace, healthPath: '', name: $name));

    writeFile("{$appRoot}/templates/index.latte", renderTemplate(<<<'LATTE'
<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{$title}</title>
    <style>
        body { font-family: system-ui, sans-serif; max-width: 720px; margin: 40px auto; padding: 0 16px; color: #1f2937; }
        form { margin: 0; }
        .todo-form { display: flex; gap: 8px; margin: 24px 0; }
        input[type="text"] { flex: 1; padding: 10px 12px; border: 1px solid #cbd5e1; border-radius: 6px; }
        button { padding: 10px 14px; border: 0; border-radius: 6px; background: #2563eb; color: #fff; cursor: pointer; }
        ul { list-style: none; padding: 0; }
        li { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 12px 0; border-top: 1px solid #e5e7eb; }
        .completed { color: #64748b; text-decoration: line-through; }
        .empty { color: #64748b; }
    </style>
</head>
<body>
    <h1>{$title}</h1>

    <form class="todo-form" method="post" action="{$basePath === '' ? '/' : $basePath}">
        <input type="text" name="title" placeholder="New todo" required>
        <button type="submit">Add</button>
    </form>

    {if count($todos) === 0}
        <p class="empty">No todos yet.</p>
    {else}
        <ul>
            {foreach $todos as $todo}
                <li>
                    <span class="{$todo['completed'] ? 'completed' : ''}">{$todo['title']}</span>
                    {if !$todo['completed']}
                        <form method="post" action="{$basePath}/{$todo['id']}/complete">
                            <button type="submit">Complete</button>
                        </form>
                    {/if}
                </li>
            {/foreach}
        </ul>
    {/if}
</body>
</html>
LATTE, namespace: $namespace, healthPath: '', name: $name));
}

function relativePath(string $root, string $path): string
{
    $prefix = rtrim($root, '/') . '/';
    if (str_starts_with($path, $prefix)) {
        return substr($path, strlen($prefix));
    }

    return $path;
}
