function writeMinimalSource(string $appRoot, string $namespace, string $name, string $basePath): void
{
    writeFile("{$appRoot}/src/Presentation/Http/Controller/Index/Controller.php", renderTemplate(<<<'PHP'
<?php

declare(strict_types=1);

namespace App\{{ namespace }}\Presentation\Http\Controller\Index;

use Pera\Framework\Http\Request;
use Pera\Framework\Http\Response;
use Pera\Framework\View\ITemplateRenderer;
use App\Shared\Database\PdoHelper;
use PDO;

final readonly class Controller
{
    public function __construct(
        private PDO $pdo,
        private ITemplateRenderer $renderer,
    ) {
    }

    /** @param array<string, string> $vars */
    public function __invoke(Request $request, array $vars = []): Response
    {
        $this->ensureSchema();
        $this->ensureWelcomeMessage();

        $message = PdoHelper::fetchColumn(statement: PdoHelper::query(
            pdo: $this->pdo,
            sql: 'SELECT body FROM scaffold_messages ORDER BY id ASC LIMIT 1',
        ));
        $message = is_scalar($message) ? (string) $message : '{{ name }} is running.';

        return new Response(
            body: $this->renderer->render(template: 'index.latte', params: [
                'title' => '{{ name }}',
                'message' => $message,
                'path' => '{{ basePath }}',
            ]),
            headers: ['Content-Type' => 'text/html; charset=utf-8'],
        );
    }

    private function ensureSchema(): void
    {
        $this->pdo->exec('CREATE TABLE IF NOT EXISTS scaffold_messages (id INTEGER PRIMARY KEY, body VARCHAR(255) NOT NULL)');
    }

    private function ensureWelcomeMessage(): void
    {
        $count = PdoHelper::fetchColumn(statement: PdoHelper::query(
            pdo: $this->pdo,
            sql: 'SELECT COUNT(*) FROM scaffold_messages',
        ));
        if ((int) $count > 0) {
            return;
        }

        $statement = PdoHelper::prepare(
            pdo: $this->pdo,
            sql: 'INSERT INTO scaffold_messages (id, body) VALUES (:id, :body)',
        );
        PdoHelper::execute(statement: $statement, params: ['id' => 1, 'body' => '{{ name }} is running.']);
    }
}
PHP, namespace: $namespace, healthPath: '', name: $name, basePath: $basePath));

    writeFile("{$appRoot}/templates/index.latte", renderTemplate(<<<'LATTE'
