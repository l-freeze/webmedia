{
  "name": "pera/framework",
  "description": "A lightweight PHP framework for explicit application composition.",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": ">=8.5",
    "composer-runtime-api": "^2.2",
    "ext-session": "*",
    "ext-uri": "*",
    "nikic/fast-route": "^1.3",
    "psr/container": "^2.0",
    "psr/log": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "Pera\\Framework\\": "src/"
    }
  },
  "bin": [
    "bin/scaffold-app",
    "bin/scaffold-kernel",
    "bin/scaffold-shared"
  ],
  "config": {
    "sort-packages": true
  }
}
