{
  "name": "pera/framework",
  "description": "A lightweight PHP framework for explicit application composition.",
  "keywords": [
    "framework",
    "frankenphp",
    "http",
    "php"
  ],
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.5",
    "composer-runtime-api": "^2.2",
    "ext-session": "*",
    "ext-uri": "*",
    "nikic/fast-route": "^1.3",
    "psr/container": "^2.0",
    "psr/log": "^3.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "Pera\\Framework\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Pera\\Framework\\Tests\\": "tests/"
    }
  },
  "bin": [
    "bin/scaffold-app",
    "bin/scaffold-kernel",
    "bin/scaffold-shared"
  ],
  "config": {
    "sort-packages": true
  },
  "scripts": {
    "analyse": "phpstan analyse --memory-limit=1G",
    "test": "phpunit"
  }
}
