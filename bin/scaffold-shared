#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Scaffold shared application support under apps/shared.
 *
 * Usage:
 *   php bin/scaffold-shared
 *   php bin/scaffold-shared --root=/tmp/example
 */

$args = array_values(array_slice($argv, 1));
$root = dirname(__DIR__);
foreach ($args as $arg) {
    if (str_starts_with($arg, '--root=')) {
        $root = rtrim(substr($arg, strlen('--root=')), '/');
        continue;
    }

    fwrite(STDERR, "Usage: php bin/scaffold-shared [--root=/path/to/project]\n");
    exit(1);
}

$sharedRoot = "{$root}/apps/shared";
$directories = [
    "{$sharedRoot}/config",
    "{$sharedRoot}/src/Security/Infrastructure/Http",
    "{$sharedRoot}/src/View/Infrastructure",
];
$files = [
    "{$sharedRoot}/README.md" => <<<'MARKDOWN'
# Shared Application Layer

`apps/shared` contains application-side common services and middleware that are shared by multiple apps.

Framework stays thin: HTTP primitives, routing, container, middleware pipeline, runtime, and bootstrap live in Framework. Application requirements such as security headers are inserted from shared middleware.

The default shared scaffold also includes a Latte implementation of the Framework template renderer interface. Framework defines only the renderer interface; the template engine implementation is application-side shared infrastructure.

## Middleware

`apps/shared/config/middleware.php` returns middleware class names that should be applied to every app that imports shared middleware.

`bin/scaffold-app` generates `apps/{name}/config/middleware.php` so it reads this shared middleware list automatically.

## View

`App\Shared\View\Infrastructure\LatteTemplateRenderer` implements `App\Framework\View\TemplateRenderer`.

Register it in each app container with that app's template directory and cache directory:

```php
$container->singleton(
    id: TemplateRenderer::class,
    factory: fn (): TemplateRenderer => new LatteTemplateRenderer(
        templateDirectory: $root . '/apps/front/templates',
        cacheDirectory: $root . '/storage/cache',
    ),
);
```
MARKDOWN,
    "{$sharedRoot}/config/container.php" => <<<'PHP'
<?php

declare(strict_types=1);

use App\Framework\Container\Container;

return static function (Container $container, string $root): void {
};
PHP,
    "{$sharedRoot}/config/middleware.php" => <<<'PHP'
<?php

declare(strict_types=1);

use App\Shared\Security\Infrastructure\Http\SecurityHeadersMiddleware;

return [
    SecurityHeadersMiddleware::class,
];
PHP,
    "{$sharedRoot}/src/Security/Infrastructure/Http/SecurityHeadersMiddleware.php" => <<<'PHP'
<?php

declare(strict_types=1);

namespace App\Shared\Security\Infrastructure\Http;

use App\Framework\Http\Middleware\MiddlewareInterface;
use App\Framework\Http\Middleware\RequestHandlerInterface;
use App\Framework\Http\Request;
use App\Framework\Http\Response;

final readonly class SecurityHeadersMiddleware implements MiddlewareInterface
{
    /**
     * @param array<string, string> $headers
     */
    public function __construct(
        private array $headers = [
            'X-Content-Type-Options' => 'nosniff',
            'X-Frame-Options' => 'DENY',
            'Referrer-Policy' => 'strict-origin-when-cross-origin',
            'Permissions-Policy' => 'camera=(), microphone=(), geolocation=()',
            'Content-Security-Policy' => "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'",
        ],
    ) {
    }

    public function process(Request $request, RequestHandlerInterface $handler): Response
    {
        $response = $handler->handle(request: $request);

        foreach ($this->headers as $name => $value) {
            if (!array_key_exists($name, $response->headers)) {
                $response = $response->withHeader(name: $name, value: $value);
            }
        }

        return $response;
    }
}
PHP,
    "{$sharedRoot}/src/View/Infrastructure/LatteTemplateRenderer.php" => <<<'PHP'
<?php

declare(strict_types=1);

namespace App\Shared\View\Infrastructure;

use App\Framework\View\TemplateRenderer;
use Latte\Engine;

final class LatteTemplateRenderer implements TemplateRenderer
{
    private Engine $engine;

    private string $templateDirectory;

    /** @var array<int, callable(): array<string, mixed>> */
    private array $globalProviders = [];

    public function __construct(string $templateDirectory, string $cacheDirectory)
    {
        $this->engine = new Engine();
        $this->engine->setTempDirectory($cacheDirectory);
        $this->templateDirectory = rtrim($templateDirectory, '/');
    }

    /** @param callable(): array<string, mixed> $provider */
    public function addGlobalProvider(callable $provider): void
    {
        $this->globalProviders[] = $provider;
    }

    /** @param array<string, mixed> $params */
    public function render(string $template, array $params = []): string
    {
        $globalParams = [];
        foreach ($this->globalProviders as $provider) {
            $globalParams = array_merge($globalParams, $provider());
        }

        return $this->engine->renderToString(
            $this->templateDirectory . '/' . ltrim($template, '/'),
            array_merge($globalParams, $params),
        );
    }
}
PHP,
];

foreach (array_keys($files) as $path) {
    if (file_exists($path)) {
        fwrite(STDERR, "Refusing to overwrite existing file: {$path}\n");
        exit(1);
    }
}

foreach ($directories as $directory) {
    ensureDirectory($directory);
}

foreach ($files as $path => $contents) {
    writeFile(path: $path, contents: $contents);
}

echo "Created shared scaffold: apps/shared\n\n";
echo "Created directories:\n";
foreach ($directories as $directory) {
    echo '- ' . relativePath(root: $root, path: $directory) . "\n";
}
echo "\n";
echo "Created files:\n";
foreach (array_keys($files) as $path) {
    echo '- ' . relativePath(root: $root, path: $path) . "\n";
}
echo "\n";
echo "Add this PSR-4 entry to composer.json when this is a new project:\n\n";
echo "\"App\\\\Shared\\\\\": \"apps/shared/src/\"\n";

function ensureDirectory(string $directory): void
{
    if (is_dir($directory)) {
        return;
    }

    if (!mkdir($directory, 0775, true) && !is_dir($directory)) {
        fwrite(STDERR, "Failed to create directory: {$directory}\n");
        exit(1);
    }
}

function writeFile(string $path, string $contents): void
{
    if (file_put_contents($path, $contents) === false) {
        fwrite(STDERR, "Failed to write file: {$path}\n");
        exit(1);
    }
}

function relativePath(string $root, string $path): string
{
    $root = rtrim($root, '/') . '/';
    return str_starts_with($path, $root) ? substr($path, strlen($root)) : $path;
}
