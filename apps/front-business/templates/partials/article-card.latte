<article class="card article-card">
  {if ($article['eyecatch_path'] ?? '') !== ''}
    <img class="thumb article-card__media" src="{$article['eyecatch_path']}" alt="{$article['title']}" loading="lazy">
  {/if}
  <div class="article-card__body">
    <span class="label">{$article['category_name'] ?? '未分類'}</span>
    <h2><a href="{$basePath}/articles/{$article['slug']}">{$article['title']}</a></h2>
    <p>{$article['excerpt']}</p>
    <p class="meta">公開 {$article['published_at']} / 更新 {$article['updated_at']}</p>
  </div>
</article>
