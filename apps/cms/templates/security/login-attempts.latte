{layout '../layout/default.latte'}
{block content}
{ifset $flash}
  <div class="mb-4 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 font-bold text-emerald-700" role="status" aria-live="polite" data-auto-dismiss>{$flash}</div>
{/ifset}
{ifset $error}
  <div class="mb-4 rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 font-bold text-rose-700" role="alert" data-auto-dismiss>{$error}</div>
{/ifset}

<section class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
  <h1 class="mb-4 text-2xl font-bold">ログイン制限解除</h1>
  <div class="grid gap-5 lg:grid-cols-2">
    <form method="post" action="/admin/security/login-attempts/reset" class="grid gap-4">
      <input type="hidden" name="_csrf" value="{$csrf}">
      <input type="hidden" name="scope" value="email_ip">
      <label>管理者メールアドレス<input name="email" type="email" value="{$formValues['email'] ?? ''}" autocomplete="off"></label>
      <label>IPアドレス<input name="ip_address" value="{$formValues['ip_address'] ?? ''}" autocomplete="off"></label>
      <label>解除理由<textarea name="reason">{$formValues['reason'] ?? ''}</textarea></label>
      <div>
        <button class="inline-flex min-h-10 items-center justify-center rounded-lg bg-blue-600 px-4 py-2 font-bold text-white hover:bg-blue-700">メール + IP の制限を解除</button>
      </div>
    </form>

    <form method="post" action="/admin/security/login-attempts/reset" class="grid gap-4">
      <input type="hidden" name="_csrf" value="{$csrf}">
      <input type="hidden" name="scope" value="ip">
      <label>IPアドレス<input name="ip_address" value="{$formValues['ip_address'] ?? ''}" autocomplete="off"></label>
      <label>解除理由<textarea name="reason">{$formValues['reason'] ?? ''}</textarea></label>
      <div>
        <button class="inline-flex min-h-10 items-center justify-center rounded-lg bg-slate-700 px-4 py-2 font-bold text-white hover:bg-slate-800">IP 全体の制限を解除</button>
      </div>
    </form>
  </div>
</section>
{/block}
