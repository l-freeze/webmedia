{layout '../layout/default.latte'}
{block content}
<section class="grid gap-4 rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
  <h1 class="text-2xl font-bold">メディア管理</h1>
  {ifset $flash}
    <div class="rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 font-bold text-emerald-700" role="status" aria-live="polite" data-auto-dismiss>{$flash}</div>
  {/ifset}
  {ifset $error}
    <div class="rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 font-bold text-rose-700" role="alert" data-auto-dismiss>{$error}</div>
  {/ifset}
  <form method="post" action="/admin/media" enctype="multipart/form-data" class="grid gap-4 lg:grid-cols-2">
    <input type="hidden" name="_csrf" value="{$csrf}">
    <label class="lg:col-span-2">メディアファイル
      <input type="file" name="media_file" accept="image/jpeg,image/png,image/webp,image/gif,video/mp4,video/webm,video/ogg,video/quicktime,video/x-msvideo,.avi" required>
    </label>
    <label>代替テキスト
      <input name="alt_text" placeholder="画像の内容を説明">
    </label>
    <label>キャプション
      <input name="caption" placeholder="必要な場合のみ入力">
    </label>
    <button class="inline-flex min-h-10 w-fit items-center justify-center rounded-lg bg-blue-600 px-4 py-2 font-bold text-white hover:bg-blue-700" type="submit">アップロード</button>
  </form>
</section>

<section class="mt-5 rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
  <h2 class="mb-4 text-lg font-bold">登録済みメディア</h2>
  {if count($media) === 0}
    <p class="text-sm text-slate-500">まだメディアは登録されていません。</p>
  {else}
    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
      {foreach $media as $item}
        <article class="overflow-hidden rounded-lg border border-slate-200 bg-white">
          {if $item['is_image']}
            <button
              class="block aspect-[4/3] w-full bg-slate-100 p-0"
              type="button"
              data-media-preview-src="{$item['path']}"
              data-media-preview-title="{$item['file_name']}"
              data-media-preview-alt="{$item['alt_text'] ?: $item['file_name']}"
              aria-label="{$item['file_name']}を大きく表示"
            >
              <img class="h-full w-full object-cover" src="{$item['path']}" alt="{$item['alt_text'] ?: $item['file_name']}" loading="lazy">
            </button>
          {elseif $item['is_video']}
            <video class="aspect-[4/3] w-full bg-slate-100 object-contain" src="{$item['path']}" controls preload="metadata"></video>
          {else}
            <div class="grid aspect-[4/3] place-items-center bg-slate-100 text-sm font-bold text-slate-500">プレビュー未対応</div>
          {/if}
          <div class="grid gap-2 p-4">
            <strong class="break-all text-sm">{$item['file_name']}</strong>
            <code class="break-all rounded bg-slate-100 px-2 py-1 text-xs text-slate-600">{$item['path']}</code>
            <span class="text-xs text-slate-500">{$item['mime_type']} / {$item['file_size']} bytes</span>
            <form method="post" action="/admin/media/{$item['id']}/delete" onsubmit="return confirm('このメディアを削除しますか？記事のアイキャッチに使われている場合は解除されます。')">
              <input type="hidden" name="_csrf" value="{$csrf}">
              <button class="inline-flex min-h-9 items-center justify-center rounded-lg bg-red-600 px-3 py-1.5 text-sm font-bold text-white hover:bg-red-700" type="submit">削除</button>
            </form>
          </div>
        </article>
      {/foreach}
    </div>
    <div class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/70 p-4" data-media-preview-modal role="dialog" aria-modal="true" aria-labelledby="media-preview-title" aria-hidden="true" hidden>
      <div class="flex max-h-[90vh] w-[min(100%,1100px)] flex-col overflow-hidden rounded-lg bg-white shadow-2xl">
        <header class="flex items-center justify-between gap-4 border-b border-slate-200 px-4 py-3">
          <strong id="media-preview-title" data-media-preview-title></strong>
          <button class="inline-flex min-h-9 items-center justify-center rounded-lg bg-slate-200 px-3 py-1.5 text-sm font-bold text-slate-800 hover:bg-slate-300" type="button" data-media-preview-close>閉じる</button>
        </header>
        <div class="overflow-auto bg-slate-100 p-4" data-media-preview-viewport>
          <img class="mx-auto max-h-[72vh] max-w-full cursor-zoom-in object-contain" data-media-preview-image src="" alt="" role="button" tabindex="0" aria-label="画像を実寸表示に切り替え">
        </div>
      </div>
    </div>
  {/if}
</section>
{/block}
