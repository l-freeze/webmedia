{layout '../layout/default.latte'}
{block content}
<div class="admin-grid">
  {foreach $stats as $label => $count}
    <section class="card"><p class="muted">{$label}</p><strong style="font-size:2rem">{$count}</strong></section>
  {/foreach}
</div>
<section class="card" style="margin-top:20px">
  <h2>クイックアクション</h2>
  <div class="nav">
    <a class="button" href="/admin/articles/create">新規記事作成</a>
    <a class="button secondary" href="/admin/articles">記事一覧</a>
    <a class="button secondary" href="/admin/inquiries">問い合わせ一覧</a>
  </div>
</section>
{/block}
