{layout '../layout/default.latte'}
{block content}
<div class="nav" style="justify-content:space-between;margin-bottom:16px">
  <form class="search-inline" method="get"><input name="q" value="{$query}" placeholder="記事検索"><button>検索</button></form>
  <a class="button" href="/admin/articles/create">新規記事</a>
</div>
<div class="table-wrap">
  <table>
    <thead><tr><th>タイトル</th><th>状態</th><th>カテゴリ</th><th>更新日</th><th>操作</th></tr></thead>
    <tbody>
    {foreach $articles as $article}
      <tr>
        <td><a href="/admin/articles/{$article['id']}">{$article['title']}</a></td>
        <td><span class="label status-{$article['status']}">{$article['status_label']}</span></td>
        <td>{$article['category_name'] ?? '未分類'}</td>
        <td>{$article['updated_at']}</td>
        <td><a href="/admin/articles/{$article['id']}">編集</a> / <a href="/admin/articles/{$article['id']}/preview">プレビュー</a> / <a href="/admin/articles/{$article['id']}/history">履歴</a></td>
      </tr>
    {/foreach}
    </tbody>
  </table>
</div>
{/block}
