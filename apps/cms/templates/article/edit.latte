{layout '../layout/default.latte'}
{block head}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.css">
  <style>
    .article-rich-editor .ProseMirror > * + * { margin-top: 1rem; }
    .article-rich-editor .ProseMirror h1 { font-size: 1.875rem; font-weight: 800; line-height: 1.25; }
    .article-rich-editor .ProseMirror h2 { font-size: 1.5rem; font-weight: 700; line-height: 1.3; }
    .article-rich-editor .ProseMirror h3 { font-size: 1.25rem; font-weight: 700; line-height: 1.35; }
    .article-rich-editor .ProseMirror h4 { font-size: 1.125rem; font-weight: 700; line-height: 1.4; }
    .article-rich-editor .ProseMirror ul { list-style: disc; padding-left: 1.5rem; }
    .article-rich-editor .ProseMirror ol { list-style: decimal; padding-left: 1.5rem; }
    .article-rich-editor .ProseMirror blockquote { border-left: 4px solid #cbd5e1; padding-left: 1rem; color: #475569; }
    .article-rich-editor .ProseMirror pre { overflow-x: auto; border-radius: 0.5rem; background: #0f172a; padding: 1rem; color: #e2e8f0; }
    .article-rich-editor .ProseMirror code { border-radius: 0.25rem; background: #e2e8f0; padding: 0.125rem 0.25rem; }
    .article-rich-editor .ProseMirror pre code { background: transparent; padding: 0; }
    .article-rich-editor .ProseMirror img { max-width: 100%; border-radius: 0.5rem; }
    .article-rich-editor .ProseMirror a { color: #2563eb; text-decoration: underline; text-underline-offset: 0.18em; }
    .article-rich-editor .ProseMirror hr { margin: 1.5rem 0; border: 0; border-top: 1px solid #cbd5e1; }
    .article-rich-editor .ProseMirror table { width: 100%; border-collapse: collapse; table-layout: fixed; }
    .article-rich-editor .ProseMirror th,
    .article-rich-editor .ProseMirror td { min-width: 1em; border: 1px solid #cbd5e1; padding: 0.5rem 0.625rem; vertical-align: top; }
    .article-rich-editor .ProseMirror th { background: #f1f5f9; font-weight: 700; }
    .article-rich-editor .ProseMirror .selectedCell::after { content: ""; position: absolute; inset: 0; pointer-events: none; background: rgba(37, 99, 235, .12); }
    .article-rich-editor .ProseMirror .tableWrapper { overflow-x: auto; }
    .article-rich-editor .ProseMirror p.is-editor-empty:first-child::before { content: attr(data-placeholder); float: left; height: 0; color: #94a3b8; pointer-events: none; }
  </style>
{/block}
{block content}
<div class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_320px]">
  <form method="post" action="{$action}" class="grid gap-4 rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
    {ifset $flash}
      <div class="rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 font-bold text-emerald-700" role="status" aria-live="polite" data-auto-dismiss>{$flash}</div>
    {/ifset}
    {ifset $error}
      <div class="rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 font-bold text-rose-700" role="alert" data-auto-dismiss>{$error}</div>
    {/ifset}
    <input type="hidden" name="_csrf" value="{$csrf}">
    <div class="grid gap-4 md:grid-cols-2">
      <label>表示設定
        <select name="status">
          {foreach $statuses as $value => $label}
            <option value="{$value}" {if ($article['status'] ?? 'draft') === $value}selected{/if}>{$label}</option>
          {/foreach}
        </select>
      </label>
      <label>カテゴリ
        <select name="category_id">
          <option value="">未分類</option>
          {foreach $categories as $category}
            <option value="{$category['id']}" {if (string)($article['category_id'] ?? '') === (string)$category['id']}selected{/if}>{$category['name']}</option>
          {/foreach}
        </select>
      </label>
      <label>公開日時<input class="datetime-picker" type="text" name="published_at" value="{$article['published_at'] ?? ''}" placeholder="YYYY-MM-DD HH:MM:SS" autocomplete="off" inputmode="none"></label>
      <label>公開終了日時<input class="datetime-picker" type="text" name="published_ends_at" value="{$article['published_ends_at'] ?? ''}" placeholder="YYYY-MM-DD HH:MM:SS" autocomplete="off" inputmode="none"></label>
      <section class="grid gap-3 md:col-span-2" data-eyecatch-picker>
        <input type="hidden" name="eyecatch_path" value="{$article['eyecatch_path'] ?? ''}" data-eyecatch-input>
        <div class="flex flex-wrap items-end justify-between gap-3">
          <label class="min-w-56 flex-1">アイキャッチ画像
            <input type="search" placeholder="画像名・代替テキストで検索" autocomplete="off" data-eyecatch-search>
          </label>
          <div class="flex flex-wrap gap-2">
            <button class="inline-flex min-h-10 items-center justify-center rounded-lg bg-slate-200 px-4 py-2 font-bold text-slate-800 hover:bg-slate-300" type="button" data-eyecatch-clear>解除</button>
            <a class="inline-flex min-h-10 items-center justify-center rounded-lg bg-slate-800 px-4 py-2 font-bold text-white hover:bg-slate-700" href="/admin/media">メディアを登録</a>
          </div>
        </div>
        <div class="grid gap-3 rounded-lg border border-slate-200 bg-slate-50 p-3">
          <div class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm" data-eyecatch-preview>
            {if ($article['eyecatch_path'] ?? '') !== ''}
              <img class="h-80 w-full bg-slate-950 object-contain md:h-96" src="{$article['eyecatch_path']}" alt="{$article['title'] ?? 'アイキャッチ画像'}">
            {else}
              <div class="flex h-80 items-center justify-center border border-dashed border-slate-300 bg-white px-4 text-center text-sm font-bold text-slate-500 md:h-96">アイキャッチ未設定</div>
            {/if}
            <div class="flex min-h-11 items-center border-t border-slate-200 bg-white px-4 py-2 text-sm font-bold text-slate-700" data-eyecatch-selected-name>
              {var $selectedEyecatchName = '未設定'}
              {foreach $media as $item}
                {if ($article['eyecatch_path'] ?? '') === $item['path']}
                  {var $selectedEyecatchName = $item['file_name']}
                {/if}
              {/foreach}
              {$selectedEyecatchName}
            </div>
          </div>
          <div class="max-h-80 overflow-y-scroll pr-2 [scrollbar-gutter:stable]">
            {if count($media) === 0}
              <div class="flex min-h-40 items-center justify-center rounded-lg border border-dashed border-slate-300 bg-white px-4 text-center text-sm font-bold text-slate-500">登録済み画像はありません。</div>
            {else}
              <div class="grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-4 2xl:grid-cols-5" data-eyecatch-grid>
                {foreach $media as $item}
                  {var $isSelectedEyecatch = ($article['eyecatch_path'] ?? '') === $item['path']}
                  <button class="group relative overflow-hidden rounded-lg border bg-white text-left shadow-sm transition hover:-translate-y-0.5 hover:border-blue-400 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-blue-300 {if $isSelectedEyecatch}border-blue-600 ring-2 ring-blue-200{else}border-slate-200{/if}" type="button" data-eyecatch-option data-path="{$item['path']}" data-name="{$item['file_name']}" data-alt="{$item['alt_text']}" aria-pressed="{if $isSelectedEyecatch}true{else}false{/if}">
                    <img class="aspect-[4/3] w-full bg-slate-100 object-cover" src="{$item['path']}" alt="{$item['alt_text'] !== '' ? $item['alt_text'] : $item['file_name']}" loading="lazy">
                    <span class="block truncate px-2 py-1.5 text-xs font-bold text-slate-700">{$item['file_name']}</span>
                    <span class="{if $isSelectedEyecatch}flex{else}hidden{/if} absolute right-2 top-2 h-6 w-6 items-center justify-center rounded-full bg-blue-600 text-sm font-black text-white shadow" data-eyecatch-check aria-hidden="true">✓</span>
                  </button>
                {/foreach}
              </div>
              <div class="mt-3 hidden rounded-lg border border-dashed border-slate-300 bg-white px-4 py-6 text-center text-sm font-bold text-slate-500" data-eyecatch-empty>一致する画像はありません。</div>
            {/if}
          </div>
        </div>
      </section>
      <label class="md:col-span-2">SEOタイトル<input name="seo_title" value="{$article['seo_title'] ?? ''}"></label>
      <label class="md:col-span-2">meta description<textarea name="meta_description">{$article['meta_description'] ?? ''}</textarea></label>
    </div>
    <label>タイトル<input name="title" value="{$article['title'] ?? ''}" required></label>
    <label>スラッグ<input name="slug" value="{$article['slug'] ?? ''}" required></label>
    <div class="grid gap-2">
      <label for="article-body">本文</label>
      <div class="flex flex-wrap gap-2" aria-label="本文入力方式">
        <label class="inline-flex min-h-10 cursor-pointer items-center justify-center rounded-lg bg-slate-200 px-4 py-2 font-bold text-slate-800 hover:bg-slate-300 has-[:checked]:bg-emerald-600 has-[:checked]:text-white has-[:checked]:hover:bg-emerald-700">
          <input class="sr-only" type="radio" name="body_format" value="markdown" {if ($article['body_format'] ?? 'markdown') === 'markdown'}checked{/if}>
          Markdown
        </label>
        <label class="inline-flex min-h-10 cursor-pointer items-center justify-center rounded-lg bg-slate-200 px-4 py-2 font-bold text-slate-800 hover:bg-slate-300 has-[:checked]:bg-emerald-600 has-[:checked]:text-white has-[:checked]:hover:bg-emerald-700">
          <input class="sr-only" type="radio" name="body_format" value="html" {if ($article['body_format'] ?? 'markdown') === 'html'}checked{/if}>
          HTML
        </label>
        <label class="inline-flex min-h-10 cursor-pointer items-center justify-center rounded-lg bg-slate-200 px-4 py-2 font-bold text-slate-800 hover:bg-slate-300 has-[:checked]:bg-emerald-600 has-[:checked]:text-white has-[:checked]:hover:bg-emerald-700">
          <input class="sr-only" type="radio" name="body_format" value="rich_text" {if ($article['body_format'] ?? 'markdown') === 'rich_text'}checked{/if}>
          リッチエディター
        </label>
      </div>
      <div data-rich-editor>
        <div class="article-rich-editor relative hidden overflow-hidden rounded-lg border border-slate-300 bg-white shadow-sm" data-rich-editor-shell>
          <div class="flex flex-wrap gap-2 border-b border-slate-200 bg-slate-50 p-3" data-rich-editor-toolbar></div>
          <div data-rich-editor-mount></div>
        </div>
        <div class="hidden" data-rich-image-library>
          {foreach $media as $item}
            <button type="button" data-rich-image-option data-src="{$item['path']}" data-name="{$item['file_name']}" data-alt="{$item['alt_text']}" data-width="{$item['width']}" data-height="{$item['height']}">
              <img src="{$item['path']}" alt="{$item['alt_text'] !== '' ? $item['alt_text'] : $item['file_name']}" loading="lazy">
            </button>
          {/foreach}
        </div>
        <textarea id="article-body" name="body" required data-rich-editor-source>{$article['body'] ?? ''}</textarea>
      </div>
    </div>
    <label>概要<textarea name="excerpt">{$article['excerpt'] ?? ''}</textarea></label>
    <div class="flex justify-end gap-2">
      {if isset($article['id'])}
        <button type="submit" class="inline-flex min-h-10 items-center justify-center rounded-lg bg-red-600 px-4 py-2 font-bold text-white hover:bg-red-700" form="article-delete-form" data-confirm="この記事を削除してゴミ箱へ移動しますか？">削除</button>
      {/if}
      <button class="inline-flex min-h-10 items-center justify-center rounded-lg bg-blue-600 px-4 py-2 font-bold text-white hover:bg-blue-700" type="submit">保存</button>
    </div>
  </form>
  {if isset($article['id'])}
    <form id="article-delete-form" method="post" action="/admin/articles/{$article['id']}/delete" hidden>
      <input type="hidden" name="_csrf" value="{$csrf}">
    </form>
  {/if}
  <aside class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
    <h2 class="mb-4 text-lg font-bold">更新履歴</h2>
    {if count($versions) === 0}
      <p class="text-sm text-slate-500">まだ保存履歴はありません。</p>
    {else}
      <ol class="grid list-decimal gap-3 pl-5">
        {foreach $versions as $version}
          <li class="border-b border-slate-200 pb-3 last:border-b-0 last:pb-0">
            <a class="block font-bold text-blue-600 hover:text-blue-700" href="/admin/articles/{$article['id']}/history">{$version['created_at']}</a>
            <span class="text-sm text-slate-500">版 {$version['version_no']}</span>
          </li>
        {/foreach}
      </ol>
    {/if}
  </aside>
</div>
{/block}
{block scripts}
  <script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/l10n/ja.js"></script>
  <script type="module" src="/assets/js/cms-rich-editor.js?v=20260628-rich-editor-selection-icons"></script>
  <script>
    flatpickr('.datetime-picker', {
      allowInput: true,
      dateFormat: 'Y-m-d H:i:S',
      enableSeconds: true,
      enableTime: true,
      locale: 'ja',
      time_24hr: true
    });

    const eyecatchPicker = document.querySelector('[data-eyecatch-picker]');
    if (eyecatchPicker) {
      const eyecatchInput = eyecatchPicker.querySelector('[data-eyecatch-input]');
      const eyecatchPreview = eyecatchPicker.querySelector('[data-eyecatch-preview]');
      const eyecatchSelectedName = eyecatchPicker.querySelector('[data-eyecatch-selected-name]');
      const eyecatchSearch = eyecatchPicker.querySelector('[data-eyecatch-search]');
      const eyecatchClear = eyecatchPicker.querySelector('[data-eyecatch-clear]');
      const eyecatchOptions = Array.from(eyecatchPicker.querySelectorAll('[data-eyecatch-option]'));
      const eyecatchEmpty = eyecatchPicker.querySelector('[data-eyecatch-empty]');

      const renderEyecatchPreview = (path, name, alt) => {
        const preview = path ? document.createElement('img') : document.createElement('div');
        if (path) {
          preview.src = path;
          preview.alt = alt || name || 'アイキャッチ画像';
          preview.className = 'h-80 w-full bg-slate-950 object-contain md:h-96';
        } else {
          preview.className = 'flex h-80 items-center justify-center border border-dashed border-slate-300 bg-white px-4 text-center text-sm font-bold text-slate-500 md:h-96';
          preview.textContent = 'アイキャッチ未設定';
        }
        eyecatchPreview?.firstElementChild?.replaceWith(preview);
        if (eyecatchSelectedName) {
          eyecatchSelectedName.textContent = name || '未設定';
        }
      };

      const setEyecatch = (path, name, alt) => {
        if (eyecatchInput) {
          eyecatchInput.value = path;
        }
        for (const option of eyecatchOptions) {
          const selected = option.dataset.path === path && path !== '';
          option.setAttribute('aria-pressed', selected ? 'true' : 'false');
          option.classList.toggle('border-blue-600', selected);
          option.classList.toggle('ring-2', selected);
          option.classList.toggle('ring-blue-200', selected);
          option.classList.toggle('border-slate-200', !selected);
          option.querySelector('[data-eyecatch-check]')?.classList.toggle('hidden', !selected);
          option.querySelector('[data-eyecatch-check]')?.classList.toggle('flex', selected);
        }
        renderEyecatchPreview(path, name, alt);
      };

      for (const option of eyecatchOptions) {
        option.addEventListener('click', () => {
          setEyecatch(option.dataset.path || '', option.dataset.name || '', option.dataset.alt || '');
        });
      }

      eyecatchClear?.addEventListener('click', () => {
        setEyecatch('', '', '');
      });

      eyecatchSearch?.addEventListener('input', () => {
        const keyword = eyecatchSearch.value.trim().toLowerCase();
        let visibleCount = 0;
        for (const option of eyecatchOptions) {
          const haystack = ((option.dataset.name || '') + ' ' + (option.dataset.alt || '')).toLowerCase();
          const matched = keyword === '' || haystack.includes(keyword);
          option.classList.toggle('hidden', !matched);
          if (matched) {
            visibleCount += 1;
          }
        }
        eyecatchEmpty?.classList.toggle('hidden', visibleCount !== 0);
      });
    }
  </script>
{/block}
