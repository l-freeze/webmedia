{layout '../layout/default.latte'}
{block content}
<section class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
  <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-2xl font-bold">監査ログ</h1>
    <span class="text-sm font-bold text-slate-500">{$pagination['total_items']}件</span>
  </div>
  <form method="get" class="mb-4 rounded-lg border border-slate-200 bg-slate-50 p-4">
    <div class="grid gap-3 md:grid-cols-4">
      <label>日時 From
        <input type="date" name="date_from" value="{$filters['date_from']}">
      </label>
      <label>日時 To
        <input type="date" name="date_to" value="{$filters['date_to']}">
      </label>
      <label>結果
        <input type="text" name="result" value="{$filters['result']}" placeholder="success">
      </label>
      <label>操作
        <input type="text" name="action" value="{$filters['action']}" placeholder="article.updated">
      </label>
      <label>対象
        <input type="text" name="resource_type" value="{$filters['resource_type']}" placeholder="article">
      </label>
      <label>ID
        <input type="text" name="resource_id" value="{$filters['resource_id']}" placeholder="17">
      </label>
      <label>ユーザー
        <input type="text" name="actor_user_id" value="{$filters['actor_user_id']}" placeholder="1">
      </label>
      <label>表示件数
        <input type="number" min="1" max="200" name="limit" value="{$pagination['per_page']}">
      </label>
    </div>
    <input type="hidden" name="sort" value="{$sort}">
    <div class="mt-3 flex flex-wrap items-center gap-2">
      <button class="inline-flex min-h-10 items-center justify-center rounded-lg bg-slate-800 px-4 py-2 font-bold text-white hover:bg-slate-700">絞り込み</button>
      <a class="inline-flex min-h-10 items-center justify-center rounded-lg bg-slate-200 px-4 py-2 font-bold text-slate-800 hover:bg-slate-300" href="/admin/audit-logs">解除</a>
    </div>
  </form>
  <div class="overflow-x-auto rounded-lg border border-slate-200">
    <table>
      <thead>
      <tr>
        <th><a class="inline-flex items-center gap-1 text-blue-600 hover:text-blue-700" href="{$sortToggleUrl}">日時{if $sort === 'asc'} ↑{else} ↓{/if}</a></th>
        <th>結果</th>
        <th>操作</th>
        <th>対象</th>
        <th>ID</th>
        <th>ユーザー</th>
        <th>詳細</th>
      </tr>
      </thead>
      <tbody>
      {foreach $rows as $row}
        <tr>
          <td class="whitespace-nowrap">{$row->timestamp}</td>
          <td>{$row->result}</td>
          <td class="whitespace-nowrap">{$row->action}</td>
          <td>{$row->resourceType}</td>
          <td>{$row->resourceId}</td>
          <td>{$row->actorUserId}</td>
          <td class="max-w-xl break-words font-mono text-xs">{$row->detail}</td>
        </tr>
      {/foreach}
      {if count($rows) === 0}
        <tr><td colspan="7" class="text-slate-500">監査ログはまだありません。</td></tr>
      {/if}
      </tbody>
    </table>
  </div>
  {if $pagination['total_pages'] > 1}
    <nav class="mt-4 flex flex-wrap items-center justify-end gap-2" aria-label="監査ログページ">
      {if $pagination['previous_url'] !== null}
        <a class="inline-flex min-h-9 items-center justify-center rounded-lg bg-slate-200 px-3 py-1.5 text-sm font-bold text-slate-800 hover:bg-slate-300" href="{$pagination['previous_url']}">前へ</a>
      {/if}
      <span class="text-sm font-bold text-slate-500">{$pagination['current_page']} / {$pagination['total_pages']}</span>
      {if $pagination['next_url'] !== null}
        <a class="inline-flex min-h-9 items-center justify-center rounded-lg bg-slate-200 px-3 py-1.5 text-sm font-bold text-slate-800 hover:bg-slate-300" href="{$pagination['next_url']}">次へ</a>
      {/if}
    </nav>
  {/if}
</section>
{/block}
