{layout 'layout/default.latte'}
{block content}
<section class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
  <h1 class="mb-4 text-2xl font-bold">{$heading}</h1>
  {if isset($form)}
    {ifset $flash}
      <div class="mb-4 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 font-bold text-emerald-700" role="status" aria-live="polite" data-auto-dismiss>{$flash}</div>
    {/ifset}
    {ifset $error}
      <div class="mb-4 rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 font-bold text-rose-700" role="alert" data-auto-dismiss>{$error}</div>
    {/ifset}
    <form method="post" class="mb-5 grid gap-4">
      <input type="hidden" name="_csrf" value="{$csrf}">
      {foreach $form as $field}
        <label>{$field['label']}
          {if ($field['type'] ?? 'text') === 'select'}
            <select name="{$field['name']}">
              {foreach $field['options'] as $value => $label}
                <option value="{$value}" {if (string)($formValues[$field['name']] ?? '') === (string)$value}selected{/if}>{$label}</option>
              {/foreach}
            </select>
          {else}
            <input name="{$field['name']}" value="{$formValues[$field['name']] ?? ''}">
          {/if}
        </label>
      {/foreach}
      <button class="inline-flex min-h-10 w-fit items-center justify-center rounded-lg bg-blue-600 px-4 py-2 font-bold text-white hover:bg-blue-700">保存</button>
    </form>
  {/if}
  <div class="overflow-x-auto rounded-lg border border-slate-200">
    <table>
      <thead><tr>{foreach $columns as $column}<th>{$column}</th>{/foreach}</tr></thead>
      <tbody>
      {foreach $rows as $row}
        <tr>{foreach $row as $value}<td>{$value}</td>{/foreach}</tr>
      {/foreach}
      </tbody>
    </table>
  </div>
</section>
{/block}
