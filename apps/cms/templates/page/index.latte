{layout '../layout/default.latte'}
{block content}
{ifset $flash}
  <div class="form-alert form-alert--success" role="status" aria-live="polite" data-auto-dismiss>{$flash}</div>
{/ifset}
<div class="nav" style="margin-bottom:16px">
  <a class="button" href="/admin/pages/create">新規固定ページ</a>
</div>
<div class="table-wrap">
  <table>
    <thead><tr><th>表示順</th><th>タイトル</th><th>スラッグ</th><th>状態</th><th>更新日</th><th>操作</th></tr></thead>
    <tbody>
    {foreach $pages as $page}
      <tr>
        <td>{$page['display_order']}</td>
        <td><a href="/admin/pages/{$page['id']}">{$page['title']}</a></td>
        <td>{$page['slug']}</td>
        <td><span class="label status-{$page['status']}">{$page['status']}</span></td>
        <td>{$page['updated_at']}</td>
        <td><a href="/admin/pages/{$page['id']}">編集</a></td>
      </tr>
    {/foreach}
    </tbody>
  </table>
</div>
{/block}
