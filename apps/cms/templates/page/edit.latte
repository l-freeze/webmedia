{layout '../layout/default.latte'}
{block head}
  <style>
    .article-rich-editor .ProseMirror > * + * { margin-top: 1rem; }
    .article-rich-editor .ProseMirror h1 { font-size: 1.875rem; font-weight: 800; line-height: 1.25; }
    .article-rich-editor .ProseMirror h2 { font-size: 1.5rem; font-weight: 700; line-height: 1.3; }
    .article-rich-editor .ProseMirror h3 { font-size: 1.25rem; font-weight: 700; line-height: 1.35; }
    .article-rich-editor .ProseMirror h4 { font-size: 1.125rem; font-weight: 700; line-height: 1.4; }
    .article-rich-editor .ProseMirror ul { list-style: disc; padding-left: 1.5rem; }
    .article-rich-editor .ProseMirror ol { list-style: decimal; padding-left: 1.5rem; }
    .article-rich-editor .ProseMirror blockquote { border-left: 4px solid #cbd5e1; padding-left: 1rem; color: #475569; }
    .article-rich-editor .ProseMirror pre { overflow-x: auto; border-radius: 0.5rem; background: #0f172a; padding: 1rem; color: #e2e8f0; }
    .article-rich-editor .ProseMirror code { border-radius: 0.25rem; background: #e2e8f0; padding: 0.125rem 0.25rem; }
    .article-rich-editor .ProseMirror pre code { background: transparent; padding: 0; }
    .article-rich-editor .ProseMirror img { max-width: 100%; border-radius: 0.5rem; }
    .article-rich-editor .ProseMirror a { color: #2563eb; text-decoration: underline; text-underline-offset: 0.18em; }
    .article-rich-editor .ProseMirror hr { margin: 1.5rem 0; border: 0; border-top: 1px solid #cbd5e1; }
    .article-rich-editor .ProseMirror table { width: 100%; border-collapse: collapse; table-layout: fixed; }
    .article-rich-editor .ProseMirror th,
    .article-rich-editor .ProseMirror td { min-width: 1em; border: 1px solid #cbd5e1; padding: 0.5rem 0.625rem; vertical-align: top; }
    .article-rich-editor .ProseMirror th { background: #f1f5f9; font-weight: 700; }
    .article-rich-editor .ProseMirror .selectedCell::after { content: ""; position: absolute; inset: 0; pointer-events: none; background: rgba(37, 99, 235, .12); }
    .article-rich-editor .ProseMirror .tableWrapper { overflow-x: auto; }
    .article-rich-editor .ProseMirror p.is-editor-empty:first-child::before { content: attr(data-placeholder); float: left; height: 0; color: #94a3b8; pointer-events: none; }
  </style>
{/block}
{block content}
<div class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_320px]">
  <form method="post" action="{$action}" class="grid gap-4 rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
    {ifset $flash}
      <div class="rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 font-bold text-emerald-700" role="status" aria-live="polite" data-auto-dismiss>{$flash}</div>
    {/ifset}
    {ifset $error}
      <div class="rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 font-bold text-rose-700" role="alert" data-auto-dismiss>{$error}</div>
    {/ifset}
    <input type="hidden" name="_csrf" value="{$csrf}">
    <div class="grid gap-4 md:grid-cols-2">
      <label>状態
        <select name="status">
          {foreach $statuses as $value => $label}
            <option value="{$value}" {if ($page['status'] ?? 'draft') === $value}selected{/if}>{$label}</option>
          {/foreach}
        </select>
      </label>
      <label>表示順<input type="number" name="display_order" value="{$page['display_order'] ?? 0}" min="0" step="1"></label>
      <label>SEOタイトル<input name="seo_title" value="{$page['seo_title'] ?? ''}"></label>
      <label class="md:col-span-2">meta description<textarea name="meta_description">{$page['meta_description'] ?? ''}</textarea></label>
    </div>
    <label>タイトル<input name="title" value="{$page['title'] ?? ''}" required></label>
    <label>スラッグ<input name="slug" value="{$page['slug'] ?? ''}" required></label>
    <div class="grid gap-2">
      <label for="page-body">本文</label>
      <div class="flex flex-wrap gap-2" aria-label="本文入力方式">
        <label class="inline-flex min-h-10 cursor-pointer items-center justify-center rounded-lg bg-slate-200 px-4 py-2 font-bold text-slate-800 hover:bg-slate-300 has-[:checked]:bg-emerald-600 has-[:checked]:text-white has-[:checked]:hover:bg-emerald-700">
          <input class="sr-only" type="radio" name="body_format" value="markdown" {if ($page['body_format'] ?? 'markdown') === 'markdown'}checked{/if}>
          Markdown
        </label>
        <label class="inline-flex min-h-10 cursor-pointer items-center justify-center rounded-lg bg-slate-200 px-4 py-2 font-bold text-slate-800 hover:bg-slate-300 has-[:checked]:bg-emerald-600 has-[:checked]:text-white has-[:checked]:hover:bg-emerald-700">
          <input class="sr-only" type="radio" name="body_format" value="html" {if ($page['body_format'] ?? 'markdown') === 'html'}checked{/if}>
          HTML
        </label>
        <label class="inline-flex min-h-10 cursor-pointer items-center justify-center rounded-lg bg-slate-200 px-4 py-2 font-bold text-slate-800 hover:bg-slate-300 has-[:checked]:bg-emerald-600 has-[:checked]:text-white has-[:checked]:hover:bg-emerald-700">
          <input class="sr-only" type="radio" name="body_format" value="rich_text" {if ($page['body_format'] ?? 'markdown') === 'rich_text'}checked{/if}>
          リッチエディター
        </label>
      </div>
      <div data-rich-editor>
        <div class="article-rich-editor relative hidden overflow-hidden rounded-lg border border-slate-300 bg-white shadow-sm" data-rich-editor-shell>
          <div class="flex flex-wrap gap-2 border-b border-slate-200 bg-slate-50 p-3" data-rich-editor-toolbar></div>
          <div data-rich-editor-mount></div>
        </div>
        <div class="hidden" data-rich-image-library>
          {foreach $media as $item}
            <button type="button" data-rich-image-option data-src="{$item['path']}" data-name="{$item['file_name']}" data-alt="{$item['alt_text']}">
              <img src="{$item['path']}" alt="{$item['alt_text'] !== '' ? $item['alt_text'] : $item['file_name']}" loading="lazy">
            </button>
          {/foreach}
        </div>
        <textarea id="page-body" name="body" required data-rich-editor-source>{$page['body'] ?? ''}</textarea>
      </div>
    </div>
    <div class="flex justify-end">
      <button class="inline-flex min-h-10 items-center justify-center rounded-lg bg-blue-600 px-4 py-2 font-bold text-white hover:bg-blue-700" type="submit">保存</button>
    </div>
  </form>
  <aside class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
    <h2 class="mb-4 text-lg font-bold">更新履歴</h2>
    {if count($versions) === 0}
      <p class="text-sm text-slate-500">まだ保存履歴はありません。</p>
    {else}
      <ol class="grid list-decimal gap-3 pl-5">
        {foreach $versions as $version}
          <li class="border-b border-slate-200 pb-3 last:border-b-0 last:pb-0">
            <div class="grid gap-2">
              <div>
                <span>{$version['created_at']}</span>
                <span class="text-sm text-slate-500">版 {$version['version_no']}</span>
              </div>
              <form class="m-0" method="post" action="/admin/pages/{$page['id']}/restore/{$version['version_no']}">
                <input type="hidden" name="_csrf" value="{$csrf}">
                <button class="inline-flex min-h-9 items-center justify-center rounded-lg bg-blue-600 px-3 py-1.5 text-sm font-bold text-white hover:bg-blue-700" data-confirm="この版へ復元しますか？">復元</button>
              </form>
            </div>
          </li>
        {/foreach}
      </ol>
    {/if}
  </aside>
</div>
{/block}
{block scripts}
  <script type="module" src="/assets/js/cms-rich-editor.js?v=20260629-page-rich-editor"></script>
{/block}
