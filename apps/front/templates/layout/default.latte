<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{$title} | {$siteName}</title>
  <meta name="description" content="{$description ?? ''}">
  <link rel="stylesheet" href="/assets/css/app.css?v=20260612-hero-image">
  <script src="https://unpkg.com/htmx.org@2.0.4" defer></script>
  <script type="module" src="https://unpkg.com/@hotwired/stimulus/dist/stimulus.js"></script>
  <script src="/assets/js/app.js?v=20260612-hero-image" defer></script>
</head>
<body data-front-theme="{$frontTheme ?? 'cafe-clean'}">
<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href="/">{$siteName}</a>
    <nav class="nav" aria-label="グローバルナビ">
      <a href="/categories">カテゴリ</a>
      <a href="/tags">タグ</a>
      {foreach $publishedPages as $pageLink}
        <a href="/pages/{$pageLink['slug']}">{$pageLink['title']}</a>
      {/foreach}
      <a href="/contact">問い合わせ</a>
      <a href="/menu">メニュー</a>
    </nav>
    {if $searchEnabled ?? true}
      <form class="search-inline" action="/search" method="get">
        <input name="q" value="{$query ?? ''}" placeholder="記事を検索">
        <button type="submit">検索</button>
      </form>
    {/if}
  </div>
</header>
<main class="front-shell">
  {include content}
</main>
<footer class="site-footer">
  <div class="site-footer__inner nav">
    <strong>{$siteName}</strong>
    <span class="muted">© {date('Y')} {$siteName}</span>
    {foreach $publishedPages as $pageLink}
      <a href="/pages/{$pageLink['slug']}">{$pageLink['title']}</a>
    {/foreach}
    <a href="/contact">問い合わせ</a>
  </div>
</footer>
</body>
</html>
